    m_Metadata:
      m_Items: []
  - m_Id: 458961388175361
    m_Localized: Your skills deal 1 more damage to poisoned enemies.
    m_Metadata:
      m_Items: []
  - m_Id: 458962432557056
    m_Localized: Assassin
    m_Metadata:
      m_Items: []
  - m_Id: 458962432557057
    m_Localized: Your skills deal 1 more damage to enemies with no ally next to them.
    m_Metadata:
      m_Items: []
  - m_Id: 458962789072896
    m_Localized: Assassin
    m_Metadata:
      m_Items: []
  - m_Id: 458962789072897
    m_Localized: Your skills deal 1 more damage to enemies with no ally next to them.
    m_Metadata:
      m_Items: []
  - m_Id: 458963149783040
    m_Localized: Shadow Feast
    m_Metadata:
      m_Items: []
  - m_Id: 458963149783041
    m_Localized: Killing an enemy heals you for 1 HP.
    m_Metadata:
