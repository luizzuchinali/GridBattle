  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Content_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 84108cdf327ab9342bf94b3442a30042, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 4496571990016
    m_Localized: Weakened
    m_Metadata:
      m_Items: []
  - m_Id: 4496651681792
    m_Localized: Deals 1 less damage with every hit.
    m_Metadata:
      m_Items: []
  - m_Id: 4497024974848
    m_Localized: Thorn Armor
    m_Metadata:
      m_Items: []
  - m_Id: 4497024974849
    m_Localized: Deals 1 damage to whoever hits it.
    m_Metadata:
      m_Items: []
  - m_Id: 4497381490688
    m_Localized: Life Steal
    m_Metadata:
      m_Items: []
  - m_Id: 4497381490689
    m_Localized: Recovers part of the damage dealt as HP.
    m_Metadata:
      m_Items: []
  - m_Id: 4497729617920
    m_Localized: Regeneration
    m_Metadata:
      m_Items: []
  - m_Id: 4497729617921
    m_Localized: Recovers 1 HP at the start of each of its turns.
    m_Metadata:
      m_Items: []
  - m_Id: 4498077745152
    m_Localized: Shield
    m_Metadata:
      m_Items: []
  - m_Id: 4498077745153
    m_Localized: Absorbs the next 1 damage.
    m_Metadata:
      m_Items: []
  - m_Id: 4498425872384
    m_Localized: Poisoned
    m_Metadata:
      m_Items: []
  - m_Id: 4498425872385
    m_Localized: Takes 1 damage at the start of each of its turns.
    m_Metadata:
      m_Items: []
  - m_Id: 7824852877312
    m_Localized: Armored
    m_Metadata:
      m_Items: []
  - m_Id: 7824865460224
    m_Localized: Blocks 1 damage from every hit. Collisions ignore armor.
    m_Metadata:
      m_Items: []
  - m_Id: 7825255530496
    m_Localized: Melee
    m_Metadata:
      m_Items: []
  - m_Id: 7825255530497
    m_Localized: Chases you and attacks up close.
    m_Metadata:
      m_Items: []
  - m_Id: 7825603657728
    m_Localized: Swarm
    m_Metadata:
      m_Items: []
  - m_Id: 7825603657729
    m_Localized: Fragile and fast, and comes in numbers.
    m_Metadata:
      m_Items: []
  - m_Id: 7825955979264
    m_Localized: Ranged
    m_Metadata:
      m_Items: []
  - m_Id: 7825955979265
    m_Localized: Attacks from afar and tries to keep its distance.
    m_Metadata:
      m_Items: []
  - m_Id: 7826312495104
    m_Localized: Support
    m_Metadata:
      m_Items: []
  - m_Id: 7826312495105
    m_Localized: Heals or empowers its allies. A priority target.
    m_Metadata:
      m_Items: []
  - m_Id: 7826656428032
    m_Localized: Summoner
    m_Metadata:
      m_Items: []
  - m_Id: 7826656428033
    m_Localized: Summons new enemies during the battle.
    m_Metadata:
      m_Items: []
  - m_Id: 7827000360960
    m_Localized: Controller
    m_Metadata:
      m_Items: []
  - m_Id: 7827000360961
    m_Localized: Applies negative states to you or moves you around the grid.
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462912
    m_Localized: Goblin
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462913
    m_Localized: Walks up to you and swings its club at an adjacent cell on its next turn.
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462914
    m_Localized: Slime
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462915
    m_Localized: Slow and sturdy. Splashes acid on the cell in front of it and both sides.
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462916
    m_Localized: Rat
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462917
    m_Localized: Fast and fragile. Closes in quickly and bites an adjacent cell.
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462918
    m_Localized: Eye Bat
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462919
    m_Localized: Fast and fragile. Dives on diagonal cells and, every few turns, shrieks at every cell around it, pushing whoever is there.
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462920
    m_Localized: Fire Skull
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462921
    m_Localized: Keeps its distance and shoots flame bolts in a straight line that set you Burning.
    m_Metadata:
      m_Items: []
  - m_Id: 7828212514816
    m_Localized: Goblin Shaman
    m_Metadata:
      m_Items: []
  - m_Id: 7828212514817
    m_Localized: Heals and shields injured allies and zaps you from a distance. Take it out first.
    m_Metadata:
      m_Items: []
  - m_Id: 7828325761024
    m_Localized: Rat Queen
    m_Metadata:
      m_Items: []
  - m_Id: 7828325761025
    m_Localized: Summons rats to fight for her and screeches to push you back.
    m_Metadata:
      m_Items: []
  - m_Id: 7828430618624
    m_Localized: Hexing Eye
    m_Metadata:
      m_Items: []
  - m_Id: 7828430618625
    m_Localized: Weakens you from a distance and curses a line, leaving you Exposed.
    m_Metadata:
      m_Items: []
  - m_Id: 7828539670528
    m_Localized: Armored Goblin
    m_Metadata:
      m_Items: []
  - m_Id: 7828539670529
    m_Localized: 'Armor blocks 1 damage from every hit: push it into things, collisions ignore armor.'
    m_Metadata:
      m_Items: []
  - m_Id: 7828652916736
    m_Localized: Regenerating Slime
    m_Metadata:
      m_Items: []
  - m_Id: 7828652916737
    m_Localized: Recovers 1 HP every turn. Finish it quickly.
    m_Metadata:
      m_Items: []
  - m_Id: 7828757774336
    m_Localized: Thorny Rat
    m_Metadata:
      m_Items: []
  - m_Id: 7828757774337
    m_Localized: 'Deals 1 damage to whoever hits it. Push it into others instead: collisions do not prick.'
    m_Metadata:
      m_Items: []
  - m_Id: 7840745095168
    m_Localized: Strike
    m_Metadata:
      m_Items: []
  - m_Id: 7840745095169
    m_Localized: Hit an adjacent enemy and push it 1 cell.
    m_Metadata:
      m_Items: []
  - m_Id: 7841101611008
    m_Localized: Shield Charge
    m_Metadata:
      m_Items: []
  - m_Id: 7841101611009
    m_Localized: Charge up to 3 cells in a straight line. An enemy at the end takes 1 damage and is pushed 1 cell.
    m_Metadata:
      m_Items: []
  - m_Id: 7841487486976
    m_Localized: Fireball
    m_Metadata:
      m_Items: []
  - m_Id: 7841487486977
    m_Localized: 'Hurl a fireball at a cell 2 to 3 cells away: 2 damage, and the cell burns for 2 rounds (1 damage to whoever ends a turn on it).'
    m_Metadata:
      m_Items: []
  - m_Id: 7841844002816
    m_Localized: Frost Nova
    m_Metadata:
      m_Items: []
  - m_Id: 7841844002817
    m_Localized: 'Freeze everyone around you: 1 damage, and on their next turn they cannot walk or use skills. A frozen enemy loses its prepared strike.'
    m_Metadata:
      m_Items: []
  - m_Id: 7842200518656
    m_Localized: Lightning Storm
    m_Metadata:
      m_Items: []
  - m_Id: 7842200518657
    m_Localized: 'Lightning from the sky on a cross of cells 2 to 4 cells away (no line of sight needed): 1 damage and stuns, cancelling prepared strikes. Channelled: it also spends the walk of the turn (use it before walking).'
    m_Metadata:
      m_Items: []
  - m_Id: 7842586394624
    m_Localized: Throwing Dagger
    m_Metadata:
      m_Items: []
  - m_Id: 7842586394625
    m_Localized: 'Throw a dagger at an enemy 2 to 4 cells away in a line or diagonal: 1 damage and Exposed (takes 1 more damage from every hit) until your next turn.'
    m_Metadata:
      m_Items: []
  - m_Id: 7842947104768
    m_Localized: Smoke Bomb
    m_Metadata:
      m_Items: []
  - m_Id: 7842947104769
    m_Localized: 'Burst a smoke bomb around you: 1 damage and blinds everyone around you. Blinded enemies lose their prepared strike and cannot prepare one on their next turn.'
    m_Metadata:
      m_Items: []
  - m_Id: 7843299426304
    m_Localized: Poisoned Dagger
    m_Metadata:
      m_Items: []
  - m_Id: 7843299426305
    m_Localized: 'Throw a dagger at a cell up to 3 cells away in a straight line: 1 damage and Poisoned (1 damage at the start of each of its next 2 turns).'
    m_Metadata:
      m_Items: []
  - m_Id: 7843660136448
    m_Localized: Poison Line
    m_Metadata:
      m_Items: []
  - m_Id: 7843660136449
    m_Localized: 'Spill poison in a line of 4 cells in front of you: 1 damage, Poisoned, and the cells become a poison bog for 2 rounds.'
    m_Metadata:
      m_Items: []
  - m_Id: 10290159910912
    m_Localized: Your first battle
    m_Metadata:
      m_Items: []
  - m_Id: 10290247991296
    m_Localized: 'Each turn you walk once and use one skill, in any order. Enemies mark the cells they will strike on their next turn: step out of the marks, or push, pull, stun or freeze them. Tap yourself or End turn to finish.'
    m_Metadata:
      m_Items: []
  - m_Id: 10290373820416
    m_Localized: Choose your path
    m_Metadata:
      m_Items: []
  - m_Id: 10290373820417
    m_Localized: 'Tap a node to preview it: its type and, for battles, the XP, the enemy roles and the terrain. Then confirm to enter.'
    m_Metadata:
      m_Items: []
  - m_Id: 10290495455232
    m_Localized: Level up!
    m_Metadata:
      m_Items: []
  - m_Id: 10290495455233
    m_Localized: 'The game is paused: pick 1 of 3 talents to shape your build. You can also reroll the offer, ban a talent or skip it.'
    m_Metadata:
      m_Items: []
  - m_Id: 10290604507136
    m_Localized: Health carries over
    m_Metadata:
      m_Items: []
  - m_Id: 10290604507137
    m_Localized: Your HP carries over to the next battle and does not come back when you level up. Rest at camps to heal, and plan your route around them.
    m_Metadata:
      m_Items: []
  - m_Id: 10290717753344
    m_Localized: Camp
    m_Metadata:
      m_Items: []
  - m_Id: 10290717753345
    m_Localized: At a camp you either rest to recover HP or train to turn one of your skills into a stronger version. Choose what your run needs.
    m_Metadata:
      m_Items: []
  - m_Id: 10290826805248
    m_Localized: Talent node
    m_Metadata:
      m_Items: []
  - m_Id: 10290826805249
    m_Localized: Here you can get a talent outside of leveling up, at the cost of maximum HP. Make sure it is worth it.
    m_Metadata:
      m_Items: []
  - m_Id: 10290944245760
    m_Localized: Consumables
    m_Metadata:
      m_Items: []
  - m_Id: 10290944245761
    m_Localized: Consumables are single use and only work in battle. Using one does not spend your action, but you can use only one per turn.
    m_Metadata:
      m_Items: []
  - m_Id: 10291057491968
    m_Localized: Details
    m_Metadata:
      m_Items: []
  - m_Id: 10291057491969
    m_Localized: 'Long press (right click on PC) a character to see its attributes, skills and active states. It never uses your turn: close the window with the X.'
    m_Metadata:
      m_Items: []
  - m_Id: 10291187515392
    m_Localized: Skills
    m_Metadata:
      m_Items: []
  - m_Id: 10291187515393
    m_Localized: 'Tap a skill, then a highlighted cell to aim: the preview shows the damage, the pushes and where the marked strikes will land. Tap the same cell again or Confirm to use it, or Cancel to choose again. Skills have a cooldown counted in your turns.'
    m_Metadata:
      m_Items: []
  - m_Id: 141742633615360
    m_Localized: Healing Potion
    m_Metadata:
      m_Items: []
  - m_Id: 141742713307136
    m_Localized: Restores 4 HP. Using it does not cost your action.
    m_Metadata:
      m_Items: []
  - m_Id: 141743153709056
    m_Localized: Bomb
    m_Metadata:
      m_Items: []
  - m_Id: 141743153709057
    m_Localized: 'Throw it up to 3 cells away, in line of sight: deals 2 damage to every enemy in a 3x3 area. Does not cost your action.'
    m_Metadata:
      m_Items: []
  - m_Id: 141743547973632
    m_Localized: Regeneration Tonic
    m_Metadata:
      m_Items: []
  - m_Id: 141743547973633
    m_Localized: Recover 1 HP at the start of each of your next 3 turns. Does not cost your action.
    m_Metadata:
      m_Items: []
  - m_Id: 142151209156608
    m_Localized: Rock
    m_Metadata:
      m_Items: []
  - m_Id: 142151209156609
    m_Localized: 'Rubble blocks the way: nobody can stand on it or cross it.'
    m_Metadata:
      m_Items: []
  - m_Id: 142151704084480
    m_Localized: Fire
    m_Metadata:
      m_Items: []
  - m_Id: 142151704084481
    m_Localized: Deals 1 damage to whoever ends their turn on it.
    m_Metadata:
      m_Items: []
  - m_Id: 142152127709184
    m_Localized: Poison Bog
    m_Metadata:
      m_Items: []
  - m_Id: 142152127709185
    m_Localized: Poisons whoever ends their turn on it.
    m_Metadata:
      m_Items: []
  - m_Id: 142152563916800
    m_Localized: Healing Shrine
    m_Metadata:
      m_Items: []
  - m_Id: 142152563916801
    m_Localized: Grants Regeneration to whoever ends their turn on it.
    m_Metadata:
      m_Items: []
  - m_Id: 142153050456064
    m_Localized: Ward Stone
    m_Metadata:
      m_Items: []
  - m_Id: 142153050456065
    m_Localized: Grants a Shield to whoever ends their turn on it.
    m_Metadata:
      m_Items: []
  - m_Id: 151679795429376
    m_Localized: Goblin King
    m_Metadata:
      m_Items: []
  - m_Id: 151679891898368
    m_Localized: 'Placeholder final boss: a goblin king stronger than any goblin.'
    m_Metadata:
      m_Items: []
  - m_Id: 151679891898369
    m_Localized: Cannot be pushed. Slams the cells around him and sends shockwaves down a line; both also hit his guards.
    m_Metadata:
      m_Items: []
  - m_Id: 151680038699008
    m_Localized: Goblin Guard
    m_Metadata:
      m_Items: []
  - m_Id: 151680038699009
    m_Localized: Placeholder escort of the final boss. Armored.
    m_Metadata:
      m_Items: []
  - m_Id: 151680038699010
    m_Localized: Armored escort of the king. Shoves you around, often into the king's slam.
    m_Metadata:
      m_Items: []
  - m_Id: 218482187194368
    m_Localized: Offense
    m_Metadata:
      m_Items: []
  - m_Id: 218482434658304
    m_Localized: Defense
    m_Metadata:
      m_Items: []
  - m_Id: 218482585653248
    m_Localized: Critical
    m_Metadata:
      m_Items: []
  - m_Id: 218482719870976
    m_Localized: Skills
    m_Metadata:
      m_Items: []
  - m_Id: 218482841505792
    m_Localized: Recovery
    m_Metadata:
      m_Items: []
  - m_Id: 218482958946304
    m_Localized: Utility
    m_Metadata:
      m_Items: []
  - m_Id: 218483076386816
    m_Localized: Guardian
    m_Metadata:
      m_Items: []
  - m_Id: 218483202215936
    m_Localized: Arcane
    m_Metadata:
      m_Items: []
  - m_Id: 218483328045056
    m_Localized: Shadow
    m_Metadata:
      m_Items: []
  - m_Id: 218483445485568
    m_Localized: Venom
    m_Metadata:
      m_Items: []
  - m_Id: 218484057853952
    m_Localized: Vitality
    m_Metadata:
      m_Items: []
  - m_Id: 218484057853953
    m_Localized: +2 maximum HP per rank.
    m_Metadata:
      m_Items: []
  - m_Id: 218486876426240
    m_Localized: Far Reach
    m_Metadata:
      m_Items: []
  - m_Id: 218486876426241
    m_Localized: +1 range for your skills whose range can grow.
    m_Metadata:
      m_Items: []
  - m_Id: 218488814194688
    m_Localized: Wider Choice
    m_Metadata:
      m_Items: []
  - m_Id: 218488814194689
    m_Localized: +1 talent option in every offer per stack.
    m_Metadata:
      m_Items: []
  - m_Id: 218489581752320
    m_Localized: Banisher
    m_Metadata:
      m_Items: []
  - m_Id: 218489581752321
    m_Localized: +1 ban for talent offers per stack.
    m_Metadata:
      m_Items: []
  - m_Id: 218489829216256
    m_Localized: Vitality
    m_Metadata:
      m_Items: []
  - m_Id: 218489829216257
    m_Localized: +2 maximum HP per rank.
    m_Metadata:
      m_Items: []
  - m_Id: 218491444023296
    m_Localized: Far Reach
    m_Metadata:
      m_Items: []
  - m_Id: 218491444023297
    m_Localized: +1 range for your skills whose range can grow.
    m_Metadata:
      m_Items: []
  - m_Id: 218492639399936
    m_Localized: Wider Choice
    m_Metadata:
      m_Items: []
  - m_Id: 218492639399937
    m_Localized: +1 talent option in every offer per rank.
    m_Metadata:
      m_Items: []
  - m_Id: 218493130133504
    m_Localized: Banisher
    m_Metadata:
      m_Items: []
  - m_Id: 218493130133505
    m_Localized: +1 ban for talent offers per rank.
    m_Metadata:
      m_Items: []
  - m_Id: 218493557952512
    m_Localized: Bulwark
    m_Metadata:
      m_Items: []
  - m_Id: 218493557952513
    m_Localized: 'Unlocks Shield Throw: hit an enemy 2 to 4 cells away in a straight line and push it.'
    m_Metadata:
      m_Items: []
  - m_Id: 218493989965824
    m_Localized: Grimoire
    m_Metadata:
      m_Items: []
  - m_Id: 218493989965825
    m_Localized: 'Unlocks Meteor: 2 damage on a 3x3 area far away, pushing everyone away from its center.'
    m_Metadata:
      m_Items: []
  - m_Id: 218494451339264
    m_Localized: Cryomancy
    m_Metadata:
      m_Items: []
  - m_Id: 218494451339265
    m_Localized: 'Unlocks Ice Wall: raise a wall of ice 3 cells wide that blocks walking, sight and strikes.'
    m_Metadata:
      m_Items: []
  - m_Id: 218494916907008
    m_Localized: Storm Conjurer
    m_Metadata:
      m_Items: []
  - m_Id: 218494921101312
    m_Localized: 'Unlocks Lightning Storm: lightning on a cross of cells far away that stuns, cancelling prepared strikes.'
    m_Metadata:
      m_Items: []
  - m_Id: 218495558635520
    m_Localized: Hidden Arsenal
    m_Metadata:
      m_Items: []
  - m_Id: 218495558635521
    m_Localized: 'Unlocks Throwing Dagger: hit an enemy far away in a line or diagonal and leave it Exposed.'
    m_Metadata:
      m_Items: []
  - m_Id: 218496020008960
    m_Localized: Shadow Master
    m_Metadata:
      m_Items: []
  - m_Id: 218496020008961
    m_Localized: 'Unlocks Smoke Bomb: blind everyone around you, cancelling their prepared strikes.'
    m_Metadata:
      m_Items: []
  - m_Id: 218496955338752
    m_Localized: Poison Master
    m_Metadata:
      m_Items: []
  - m_Id: 218496955338753
    m_Localized: 'Unlocks Poison Line: poison a line of 4 cells and turn it into a poison bog.'
    m_Metadata:
      m_Items: []
  - m_Id: 220859090882560
    m_Localized: Knight
    m_Metadata:
      m_Items: []
  - m_Id: 220859187351552
    m_Localized: Mage
    m_Metadata:
      m_Items: []
  - m_Id: 220859187351553
    m_Localized: Rogue
    m_Metadata:
      m_Items: []
  - m_Id: 5123292117147649
    m_Localized: Frozen or chilled enemies you push slide until they hit something.
    m_Metadata:
      m_Items: []
  - m_Id: 5123292117147648
    m_Localized: Slippery Ice
    m_Metadata:
      m_Items: []
  - m_Id: 444084762312704
    m_Localized: Shield Bash
    m_Metadata:
      m_Items: []
  - m_Id: 444084842004480
    m_Localized: 'Slam an adjacent enemy: 2 damage, push it 2 cells and stun it, cancelling its prepared strike.'
    m_Metadata:
      m_Items: []
  - m_Id: 444085320155136
    m_Localized: Gust
    m_Metadata:
      m_Items: []
  - m_Id: 444085320155137
    m_Localized: 'A blast of wind at a cell up to 3 cells away in a straight line: 1 damage and pushes the target 1 cell away from you.'
    m_Metadata:
      m_Items: []
  - m_Id: 444085714419712
    m_Localized: Hook
    m_Metadata:
      m_Items: []
  - m_Id: 444085714419713
    m_Localized: 'Throw a hook at an enemy 2 to 3 cells away in a straight line: 1 damage and pull it up to 3 cells toward you.'
    m_Metadata:
      m_Items: []
  - m_Id: 444086129655808
    m_Localized: Hook
    m_Metadata:
      m_Items: []
  - m_Id: 444086129655809
    m_Localized: 'Marks a cell 2 to 4 cells away in a straight line and hooks it on its next turn: 1 damage and drags whoever is there up to 3 cells toward the goblin.'
    m_Metadata:
      m_Items: []
  - m_Id: 444086486171648
    m_Localized: Shockwave
    m_Metadata:
      m_Items: []
  - m_Id: 444086486171649
    m_Localized: 'Marks a line of 4 cells in front of him and sends a shockwave through it on its next turn: 2 damage and throws everyone on it back 2 cells.'
    m_Metadata:
      m_Items: []
  - m_Id: 444086842687488
    m_Localized: Brute Force
    m_Metadata:
      m_Items: []
  - m_Id: 444086842687489
    m_Localized: 'Unlocks Quake: split the ground in a line of 3 cells in front of you, hitting and pushing everyone on it.'
    m_Metadata:
      m_Items: []
  - m_Id: 444087660576768
    m_Localized: Goblin Hookman
    m_Metadata:
      m_Items: []
  - m_Id: 444087660576769
    m_Localized: Hooks you from a distance and drags you toward the group.
    m_Metadata:
