    m_Metadata:
      m_Items: []
  - m_Id: 5123262002044929
    m_Localized: "Marca una l\xEDnea de 5 casillas y la golpea en su siguiente turno: 1 de da\xF1o a todos en ella."
    m_Metadata:
      m_Items: []
  - m_Id: 5123262165622784
