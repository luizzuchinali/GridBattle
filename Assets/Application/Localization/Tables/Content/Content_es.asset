    m_Metadata:
      m_Items: []
  - m_Id: 5123261301596161
    m_Localized: "Marca una casilla adyacente y la de detr\xE1s, y empuja all\xED en su siguiente turno: 1 de da\xF1o y empuja 1 casilla."
    m_Metadata:
      m_Items: []
  - m_Id: 5123261486145536
