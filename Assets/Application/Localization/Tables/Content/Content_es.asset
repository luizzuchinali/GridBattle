      m_Items: []
  - m_Id: 5123259191861248
    m_Localized: "Daga R\xE1pida"
    m_Metadata:
      m_Items: []
  - m_Id: 5123259191861249
    m_Localized: 'Sin recarga: lanza una cada turno.'
