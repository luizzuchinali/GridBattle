      m_Items: []
  - m_Id: 444086842687488
    m_Localized: Fuerza Bruta
    m_Metadata:
      m_Items: []
  - m_Id: 444086842687489
    m_Localized: "Desbloquea Sismo: parte el suelo en una l\xEDnea de 3 casillas frente a ti, golpeando y empujando a todos en ella."
    m_Metadata:
      m_Items: []
  - m_Id: 444087660576768
    m_Localized: Goblin arponero
    m_Metadata:
      m_Items: []
  - m_Id: 444087660576769
    m_Localized: Te engancha desde lejos y te arrastra hacia el grupo.
    m_Metadata:
      m_Items: []
