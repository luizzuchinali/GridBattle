    m_Metadata:
      m_Items: []
  - m_Id: 5123261809106945
    m_Localized: "Marca una cruz de casillas a 2-5 (por encima de obst\xE1culos) y la bombardea en su siguiente turno: 1 de da\xF1o a cada una."
    m_Metadata:
      m_Items: []
  - m_Id: 5123262002044928
