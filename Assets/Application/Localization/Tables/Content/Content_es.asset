      m_Items: []
  - m_Id: 5570314951532545
    m_Localized: "Marca una fila de 3 casillas delante de \xE9l y las golpea en su siguiente turno: 1 de da\xF1o y Ardiendo durante 2 turnos."
    m_Metadata:
      m_Items: []
