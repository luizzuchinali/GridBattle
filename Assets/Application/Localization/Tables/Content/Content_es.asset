    m_Metadata:
      m_Items: []
  - m_Id: 5123254800424961
    m_Localized: "Parte el suelo en una l\xEDnea de 3 casillas frente a ti: 1 de da\xF1o a todos en ella y los empuja 1 casilla."
    m_Metadata:
      m_Items: []
  - m_Id: 5123254959808512
    m_Localized: Grieta Larga
    m_Metadata:
      m_Items: []
  - m_Id: 5123254959808513
    m_Localized: "La grieta recorre 5 casillas: 1 de da\xF1o a todos en ella y los empuja 1 casilla."
    m_Metadata:
      m_Items: []
  - m_Id: 5123255110803456
    m_Localized: Sismo Profundo
    m_Metadata:
      m_Items: []
  - m_Id: 5123255110803457
    m_Localized: "Parte el suelo en una l\xEDnea de 3 casillas: 2 de da\xF1o a todos en ella y los empuja 1 casilla."
    m_Metadata:
      m_Items: []
  - m_Id: 5123255437959168
    m_Localized: "R\xE1faga Fuerte"
    m_Metadata:
      m_Items: []
  - m_Id: 5123255437959169
    m_Localized: "Una r\xE1faga m\xE1s fuerte: 1 de da\xF1o y empuja al objetivo 2 casillas lejos de ti."
    m_Metadata:
      m_Items: []
  - m_Id: 5123255597342720
    m_Localized: Vendaval
    m_Metadata:
      m_Items: []
  - m_Id: 5123255597342721
    m_Localized: "Una r\xE1faga ancha: golpea la casilla objetivo y sus lados, y empuja a cada uno 1 casilla lejos de ti."
    m_Metadata:
      m_Items: []
  - m_Id: 5123255760920576
    m_Localized: "Prisi\xF3n de Hielo"
    m_Metadata:
      m_Items: []
  - m_Id: 5123255760920577
    m_Localized: "Congela a un personaje a hasta 3 casillas: 1 de da\xF1o, y no puede caminar ni usar habilidades en su siguiente turno."
    m_Metadata:
      m_Items: []
  - m_Id: 5123255916109824
    m_Localized: "Congelaci\xF3n Profunda"
    m_Metadata:
      m_Items: []
  - m_Id: 5123255916109825
    m_Localized: "Congela a todos a tu alrededor: 2 de da\xF1o, y en su siguiente turno no pueden caminar ni usar habilidades."
    m_Metadata:
      m_Items: []
  - m_Id: 5123256083881984
    m_Localized: Bola de Fuego Explosiva
    m_Metadata:
      m_Items: []
  - m_Id: 5123256083881985
