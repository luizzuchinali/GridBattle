    m_Metadata:
      m_Items: []
  - m_Id: 5123261649723393
    m_Localized: "Marca una casilla adyacente y la de detr\xE1s, y embiste all\xED en su siguiente turno: 1 de da\xF1o y empuja 2 casillas."
    m_Metadata:
      m_Items: []
  - m_Id: 5123261809106944
