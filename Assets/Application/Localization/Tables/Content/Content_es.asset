MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Content_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 84108cdf327ab9342bf94b3442a30042, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 4496571990016
    m_Localized: Debilitado
    m_Metadata:
      m_Items: []
  - m_Id: 4496651681792
    m_Localized: "Inflige 1 menos de da\xF1o con cada golpe."
    m_Metadata:
      m_Items: []
  - m_Id: 4497024974848
    m_Localized: Armadura de Espinas
    m_Metadata:
      m_Items: []
  - m_Id: 4497024974849
    m_Localized: "Inflige 1 de da\xF1o a quien lo golpea."
    m_Metadata:
      m_Items: []
  - m_Id: 4497381490688
    m_Localized: Robo de Vida
    m_Metadata:
      m_Items: []
  - m_Id: 4497381490689
    m_Localized: "Recupera parte del da\xF1o infligido como vida."
    m_Metadata:
      m_Items: []
  - m_Id: 4497729617920
    m_Localized: "Regeneraci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 4497729617921
    m_Localized: Recupera 1 PV al inicio de cada uno de sus turnos.
    m_Metadata:
      m_Items: []
  - m_Id: 4498077745152
    m_Localized: Escudo
    m_Metadata:
      m_Items: []
  - m_Id: 4498077745153
    m_Localized: "Absorbe el siguiente 1 de da\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 4498425872384
    m_Localized: Envenenado
    m_Metadata:
      m_Items: []
  - m_Id: 4498425872385
    m_Localized: "Recibe 1 de da\xF1o al inicio de cada uno de sus turnos."
    m_Metadata:
      m_Items: []
  - m_Id: 7824852877312
    m_Localized: Blindado
    m_Metadata:
      m_Items: []
  - m_Id: 7824865460224
    m_Localized: "Bloquea 1 de da\xF1o de cada golpe. Los choques ignoran la armadura."
    m_Metadata:
      m_Items: []
  - m_Id: 7825255530496
    m_Localized: Cuerpo a cuerpo
    m_Metadata:
      m_Items: []
  - m_Id: 7825255530497
    m_Localized: Te persigue y ataca de cerca.
    m_Metadata:
      m_Items: []
  - m_Id: 7825603657728
    m_Localized: Enjambre
    m_Metadata:
      m_Items: []
  - m_Id: 7825603657729
    m_Localized: "Fr\xE1gil y r\xE1pido, y llega en grupo."
    m_Metadata:
      m_Items: []
  - m_Id: 7825955979264
    m_Localized: Tirador
    m_Metadata:
      m_Items: []
  - m_Id: 7825955979265
    m_Localized: Ataca desde lejos e intenta mantener la distancia.
    m_Metadata:
      m_Items: []
  - m_Id: 7826312495104
    m_Localized: Apoyo
    m_Metadata:
      m_Items: []
  - m_Id: 7826312495105
    m_Localized: Cura o fortalece a sus aliados. Objetivo prioritario.
    m_Metadata:
      m_Items: []
  - m_Id: 7826656428032
    m_Localized: Invocador
    m_Metadata:
      m_Items: []
  - m_Id: 7826656428033
    m_Localized: Invoca nuevos enemigos durante el combate.
    m_Metadata:
      m_Items: []
  - m_Id: 7827000360960
    m_Localized: Controlador
    m_Metadata:
      m_Items: []
  - m_Id: 7827000360961
    m_Localized: "Te aplica estados negativos o te mueve por la cuadr\xEDcula."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462912
    m_Localized: Goblin
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462913
    m_Localized: Se acerca y golpea con su garrote una casilla adyacente en su siguiente turno.
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462914
    m_Localized: Slime
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462915
    m_Localized: "Lento y resistente. Salpica \xE1cido en la casilla de enfrente y a sus lados."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462916
    m_Localized: Rata
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462917
    m_Localized: "R\xE1pida y fr\xE1gil. Se acerca deprisa y muerde una casilla adyacente."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462918
    m_Localized: "Murci\xE9lago ojo"
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462919
    m_Localized: "R\xE1pido y fr\xE1gil. Se lanza sobre casillas en diagonal y, cada pocos turnos, chilla contra todas las casillas a su alrededor y empuja a quien est\xE9 en ellas."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462920
    m_Localized: Calavera de fuego
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462921
    m_Localized: "Mantiene la distancia y dispara saetas de fuego en l\xEDnea recta que te dejan Ardiendo."
    m_Metadata:
      m_Items: []
  - m_Id: 7828212514816
    m_Localized: "Cham\xE1n goblin"
    m_Metadata:
      m_Items: []
  - m_Id: 7828212514817
    m_Localized: "Cura y protege a los aliados heridos y te electrocuta desde lejos. Elim\xEDnalo primero."
    m_Metadata:
      m_Items: []
  - m_Id: 7828325761024
    m_Localized: Reina rata
    m_Metadata:
      m_Items: []
  - m_Id: 7828325761025
    m_Localized: Invoca ratas para que luchen por ella y chilla para empujarte.
    m_Metadata:
      m_Items: []
  - m_Id: 7828430618624
    m_Localized: Ojo maldito
    m_Metadata:
      m_Items: []
  - m_Id: 7828430618625
    m_Localized: "Te debilita desde lejos y maldice una l\xEDnea, dej\xE1ndote Expuesto."
    m_Metadata:
      m_Items: []
  - m_Id: 7828539670528
    m_Localized: Goblin blindado
    m_Metadata:
      m_Items: []
  - m_Id: 7828539670529
    m_Localized: "La armadura bloquea 1 de da\xF1o de cada golpe: emp\xFAjalo contra algo, los choques ignoran la armadura."
    m_Metadata:
      m_Items: []
  - m_Id: 7828652916736
    m_Localized: Slime regenerante
    m_Metadata:
      m_Items: []
  - m_Id: 7828652916737
    m_Localized: "Recupera 1 PV cada turno. Acaba con \xE9l r\xE1pido."
    m_Metadata:
      m_Items: []
  - m_Id: 7828757774336
    m_Localized: Rata espinosa
    m_Metadata:
      m_Items: []
  - m_Id: 7828757774337
    m_Localized: "Inflige 1 de da\xF1o a quien lo golpea. Mejor emp\xFAjalo contra otros: los choques no pinchan."
    m_Metadata:
      m_Items: []
  - m_Id: 7840745095168
    m_Localized: Golpe
    m_Metadata:
      m_Items: []
  - m_Id: 7840745095169
    m_Localized: Golpea a un enemigo adyacente y lo empuja 1 casilla.
    m_Metadata:
      m_Items: []
  - m_Id: 7841101611008
    m_Localized: Embestida con Escudo
    m_Metadata:
      m_Items: []
  - m_Id: 7841101611009
    m_Localized: "Embiste hasta 3 casillas en l\xEDnea recta. El enemigo al final recibe 1 de da\xF1o y es empujado 1 casilla."
    m_Metadata:
      m_Items: []
  - m_Id: 7841487486976
    m_Localized: Bola de Fuego
    m_Metadata:
      m_Items: []
  - m_Id: 7841487486977
    m_Localized: "Lanza una bola de fuego a una casilla a 2-3: 2 de da\xF1o, y la casilla arde durante 2 rondas (1 de da\xF1o a quien termine su turno en ella)."
    m_Metadata:
      m_Items: []
  - m_Id: 7841844002816
    m_Localized: Nova de Hielo
    m_Metadata:
      m_Items: []
  - m_Id: 7841844002817
    m_Localized: "Congela a todos a tu alrededor: 1 de da\xF1o, y en su siguiente turno no pueden caminar ni usar habilidades. Un enemigo congelado pierde su golpe preparado."
    m_Metadata:
      m_Items: []
  - m_Id: 7842200518656
    m_Localized: "Tormenta El\xE9ctrica"
    m_Metadata:
      m_Items: []
  - m_Id: 7842200518657
    m_Localized: "Rayos del cielo sobre una cruz de casillas a 2-4 (no necesita l\xEDnea de visi\xF3n): 1 de da\xF1o y aturde, cancelando los golpes preparados. Canalizada: tambi\xE9n gasta el movimiento del turno (\xFAsala antes de caminar)."
    m_Metadata:
      m_Items: []
  - m_Id: 7842586394624
    m_Localized: Daga Arrojadiza
    m_Metadata:
      m_Items: []
  - m_Id: 7842586394625
    m_Localized: "Lanza una daga a un enemigo a 2-4 casillas en l\xEDnea o diagonal: 1 de da\xF1o y Expuesto (recibe 1 m\xE1s de cada golpe) hasta tu siguiente turno."
    m_Metadata:
      m_Items: []
  - m_Id: 7842947104768
    m_Localized: Bomba de Humo
    m_Metadata:
      m_Items: []
  - m_Id: 7842947104769
    m_Localized: "Revienta una bomba de humo a tu alrededor: 1 de da\xF1o y ciega a todos a tu alrededor. Los enemigos cegados pierden su golpe preparado y no pueden preparar otro en su siguiente turno."
    m_Metadata:
      m_Items: []
  - m_Id: 7843299426304
    m_Localized: Daga Envenenada
    m_Metadata:
      m_Items: []
  - m_Id: 7843299426305
    m_Localized: "Lanza una daga a una casilla a hasta 3 en l\xEDnea recta: 1 de da\xF1o y Envenenado (1 de da\xF1o al inicio de cada uno de sus 2 turnos siguientes)."
    m_Metadata:
      m_Items: []
  - m_Id: 7843660136448
    m_Localized: "L\xEDnea Venenosa"
    m_Metadata:
      m_Items: []
  - m_Id: 7843660136449
    m_Localized: "Derrama veneno en una l\xEDnea de 4 casillas frente a ti: 1 de da\xF1o, Envenenado, y las casillas se vuelven un pantano venenoso durante 2 rondas."
    m_Metadata:
      m_Items: []
  - m_Id: 10290159910912
    m_Localized: Tu primera batalla
    m_Metadata:
      m_Items: []
  - m_Id: 10290247991296
    m_Localized: "En cada turno caminas una vez y usas una habilidad, en cualquier orden. Los enemigos marcan las casillas que golpear\xE1n en su siguiente turno: sal de las marcas, o emp\xFAjalos, arr\xE1stralos, at\xFArdelos o cong\xE9lalos. T\xF3cate o pulsa Terminar para acabar."
    m_Metadata:
      m_Items: []
  - m_Id: 10290373820416
    m_Localized: Elige tu camino
    m_Metadata:
      m_Items: []
  - m_Id: 10290373820417
    m_Localized: 'Toca un nodo para ver su vista previa: el tipo y, en las batallas, el XP, los roles de los enemigos y el terreno. Luego confirma para entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 10290495455232
    m_Localized: "\xA1Subiste de nivel!"
    m_Metadata:
      m_Items: []
  - m_Id: 10290495455233
    m_Localized: "El juego est\xE1 en pausa: elige 1 de 3 talentos para formar tu build. Tambi\xE9n puedes sortear de nuevo la oferta, vetar un talento u omitirla."
    m_Metadata:
      m_Items: []
  - m_Id: 10290604507136
    m_Localized: La vida se mantiene
    m_Metadata:
      m_Items: []
  - m_Id: 10290604507137
    m_Localized: Tu vida se mantiene en la siguiente batalla y no se recupera al subir de nivel. Descansa en los campamentos para curarte y planea tu ruta en torno a ellos.
    m_Metadata:
      m_Items: []
  - m_Id: 10290717753344
    m_Localized: Campamento
    m_Metadata:
      m_Items: []
  - m_Id: 10290717753345
    m_Localized: "En un campamento descansas para recuperar vida o entrenas para convertir una de tus habilidades en una versi\xF3n m\xE1s fuerte. Elige lo que necesita tu partida."
    m_Metadata:
      m_Items: []
  - m_Id: 10290826805248
    m_Localized: Nodo de talento
    m_Metadata:
      m_Items: []
  - m_Id: 10290826805249
    m_Localized: "Aqu\xED puedes obtener un talento fuera de las subidas de nivel, a cambio de vida m\xE1xima. Aseg\xFArate de que valga la pena."
    m_Metadata:
      m_Items: []
  - m_Id: 10290944245760
    m_Localized: Consumibles
    m_Metadata:
      m_Items: []
  - m_Id: 10290944245761
    m_Localized: "Los consumibles son de un solo uso y solo funcionan en batalla. Usar uno no gasta tu acci\xF3n, pero solo puedes usar uno por turno."
    m_Metadata:
      m_Items: []
  - m_Id: 10291057491968
    m_Localized: Detalles
    m_Metadata:
      m_Items: []
  - m_Id: 10291057491969
    m_Localized: "Mant\xE9n pulsado (clic derecho en PC) un personaje para ver sus atributos, habilidades y estados activos. Nunca gasta tu turno: cierra la ventana con la X."
    m_Metadata:
      m_Items: []
  - m_Id: 10291187515392
    m_Localized: Habilidades
    m_Metadata:
      m_Items: []
  - m_Id: 10291187515393
    m_Localized: "Toca una habilidad y luego una casilla resaltada para apuntar: la vista previa muestra el da\xF1o, los empujones y d\xF3nde caer\xE1n los golpes marcados. Toca la misma casilla otra vez o Confirmar para usarla, o Cancelar para elegir de nuevo. Las habilidades tienen una recarga contada en tus turnos."
    m_Metadata:
      m_Items: []
  - m_Id: 141742633615360
    m_Localized: "Poci\xF3n de Curaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 141742713307136
    m_Localized: "Restaura 4 de vida. Usarla no gasta tu acci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 141743153709056
    m_Localized: Bomba
    m_Metadata:
      m_Items: []
  - m_Id: 141743153709057
    m_Localized: "L\xE1nzala a hasta 3 casillas, con l\xEDnea de visi\xF3n: causa 2 de da\xF1o a cada enemigo en un \xE1rea de 3x3. No gasta tu acci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 141743547973632
    m_Localized: "T\xF3nico de Regeneraci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 141743547973633
    m_Localized: "Recupera 1 PV al inicio de cada uno de tus 3 turnos siguientes. No gasta tu acci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 142151209156608
    m_Localized: Roca
    m_Metadata:
      m_Items: []
  - m_Id: 142151209156609
    m_Localized: 'Los escombros bloquean el paso: nadie puede ocupar esta casilla ni cruzarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 142151704084480
    m_Localized: Fuego
    m_Metadata:
      m_Items: []
  - m_Id: 142151704084481
    m_Localized: "Inflige 1 de da\xF1o a quien termine su turno sobre ella."
    m_Metadata:
      m_Items: []
  - m_Id: 142152127709184
    m_Localized: Pantano Venenoso
    m_Metadata:
      m_Items: []
  - m_Id: 142152127709185
    m_Localized: Envenena a quien termine su turno sobre ella.
    m_Metadata:
      m_Items: []
  - m_Id: 142152563916800
    m_Localized: Santuario Curativo
    m_Metadata:
      m_Items: []
  - m_Id: 142152563916801
    m_Localized: "Otorga Regeneraci\xF3n a quien termine su turno sobre ella."
    m_Metadata:
      m_Items: []
  - m_Id: 142153050456064
    m_Localized: Piedra Protectora
    m_Metadata:
      m_Items: []
  - m_Id: 142153050456065
    m_Localized: Otorga un Escudo a quien termine su turno sobre ella.
    m_Metadata:
      m_Items: []
  - m_Id: 151679795429376
    m_Localized: Rey Goblin
    m_Metadata:
      m_Items: []
  - m_Id: 151679891898368
    m_Localized: "Jefe final provisional: un rey goblin m\xE1s fuerte que cualquier goblin."
    m_Metadata:
      m_Items: []
  - m_Id: 151679891898369
    m_Localized: "No puede ser empujado. Golpea las casillas a su alrededor y lanza ondas de choque en l\xEDnea; ambas alcanzan tambi\xE9n a sus guardias."
    m_Metadata:
      m_Items: []
  - m_Id: 151680038699008
    m_Localized: Guardia Goblin
    m_Metadata:
      m_Items: []
  - m_Id: 151680038699009
    m_Localized: Escolta provisional del jefe final. Blindado.
    m_Metadata:
      m_Items: []
  - m_Id: 151680038699010
    m_Localized: Escolta blindada del rey. Te empuja, a menudo hacia el martillazo del rey.
    m_Metadata:
      m_Items: []
  - m_Id: 218482187194368
    m_Localized: Ataque
    m_Metadata:
      m_Items: []
  - m_Id: 218482434658304
    m_Localized: Defensa
    m_Metadata:
      m_Items: []
  - m_Id: 218482585653248
    m_Localized: "Cr\xEDtico"
    m_Metadata:
      m_Items: []
  - m_Id: 218482719870976
    m_Localized: Habilidades
    m_Metadata:
      m_Items: []
  - m_Id: 218482841505792
    m_Localized: "Recuperaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 218482958946304
    m_Localized: Utilidad
    m_Metadata:
      m_Items: []
  - m_Id: 218483076386816
    m_Localized: "Guardi\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 218483202215936
    m_Localized: Arcano
    m_Metadata:
      m_Items: []
  - m_Id: 218483328045056
    m_Localized: Sombra
    m_Metadata:
      m_Items: []
  - m_Id: 218483445485568
    m_Localized: Veneno
    m_Metadata:
      m_Items: []
  - m_Id: 218484057853952
    m_Localized: Vitalidad
    m_Metadata:
      m_Items: []
  - m_Id: 218484057853953
    m_Localized: "+2 de vida m\xE1xima por rango."
    m_Metadata:
      m_Items: []
  - m_Id: 218486876426240
    m_Localized: Largo Alcance
    m_Metadata:
      m_Items: []
  - m_Id: 218486876426241
    m_Localized: +1 de alcance para tus habilidades cuyo alcance puede crecer.
    m_Metadata:
      m_Items: []
  - m_Id: 218488814194688
    m_Localized: "M\xE1s Opciones"
    m_Metadata:
      m_Items: []
  - m_Id: 218488814194689
    m_Localized: "+1 opci\xF3n de talento en cada oferta por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218489581752320
    m_Localized: Desterrador
    m_Metadata:
      m_Items: []
  - m_Id: 218489581752321
    m_Localized: "+1 destierro de ofertas de talento por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218489829216256
    m_Localized: Vitalidad
    m_Metadata:
      m_Items: []
  - m_Id: 218489829216257
    m_Localized: "+2 de vida m\xE1xima por rango."
    m_Metadata:
      m_Items: []
  - m_Id: 218491444023296
    m_Localized: Largo Alcance
    m_Metadata:
      m_Items: []
  - m_Id: 218491444023297
    m_Localized: +1 de alcance para tus habilidades cuyo alcance puede crecer.
    m_Metadata:
      m_Items: []
  - m_Id: 218492639399936
    m_Localized: "M\xE1s Opciones"
    m_Metadata:
      m_Items: []
  - m_Id: 218492639399937
    m_Localized: "+1 opci\xF3n de talento en cada oferta por rango."
    m_Metadata:
      m_Items: []
  - m_Id: 218493130133504
    m_Localized: Desterrador
    m_Metadata:
      m_Items: []
  - m_Id: 218493130133505
    m_Localized: +1 destierro de ofertas de talento por rango.
    m_Metadata:
      m_Items: []
  - m_Id: 218493557952512
    m_Localized: Baluarte
    m_Metadata:
      m_Items: []
  - m_Id: 218493557952513
    m_Localized: "Desbloquea Lanzamiento de Escudo: golpea a un enemigo a 2-4 casillas en l\xEDnea recta y lo empuja."
    m_Metadata:
      m_Items: []
  - m_Id: 218493989965824
    m_Localized: Grimorio
    m_Metadata:
      m_Items: []
  - m_Id: 218493989965825
    m_Localized: "Desbloquea Meteoro: 2 de da\xF1o en un \xE1rea de 3x3 lejana, empujando a todos lejos del centro."
    m_Metadata:
      m_Items: []
  - m_Id: 218494451339264
    m_Localized: Criomancia
    m_Metadata:
      m_Items: []
  - m_Id: 218494451339265
    m_Localized: 'Desbloquea Muro de Hielo: levanta un muro de hielo de 3 casillas que bloquea el paso, la vista y los golpes.'
    m_Metadata:
      m_Items: []
  - m_Id: 218494916907008
    m_Localized: Conjurador de Tormentas
    m_Metadata:
      m_Items: []
  - m_Id: 218494921101312
    m_Localized: "Desbloquea Tormenta El\xE9ctrica: rayos sobre una cruz de casillas lejanas que aturden, cancelando los golpes preparados."
    m_Metadata:
      m_Items: []
  - m_Id: 218495558635520
    m_Localized: Arsenal Oculto
    m_Metadata:
      m_Items: []
  - m_Id: 218495558635521
    m_Localized: "Desbloquea Daga Arrojadiza: golpea a un enemigo lejano en l\xEDnea o diagonal y lo deja Expuesto."
