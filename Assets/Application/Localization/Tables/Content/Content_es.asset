    m_Metadata:
      m_Items: []
  - m_Id: 5123258550132737
    m_Localized: "Intercambia el lugar con un personaje a hasta 3 casillas; un enemigo recibe 1 de da\xF1o. El golpe preparado de un enemigo se mueve con \xE9l."
    m_Metadata:
      m_Items: []
  - m_Id: 5123258709516288
    m_Localized: Paso Venenoso
    m_Metadata:
      m_Items: []
  - m_Id: 5123258709516289
    m_Localized: "Intercambia el lugar con un personaje; un enemigo recibe 1 de da\xF1o y queda Envenenado."
    m_Metadata:
      m_Items: []
  - m_Id: 5123258873094144
    m_Localized: Paso Largo
    m_Metadata:
      m_Items: []
  - m_Id: 5123258873094145
    m_Localized: Intercambia el lugar con un personaje a hasta 5 casillas.
    m_Metadata:
      m_Items: []
  - m_Id: 5123259032477696
    m_Localized: Abanico de Cuchillos
    m_Metadata:
      m_Items: []
