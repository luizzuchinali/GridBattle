    m_Metadata:
      m_Items: []
  - m_Id: 5123265059692545
    m_Localized: "R\xE1pido. Su mordisco lo cura, as\xED que siempre vuelve."
    m_Metadata:
      m_Items: []
  - m_Id: 5123265227464704
    m_Localized: "Cham\xE1n del viento"
    m_Metadata:
      m_Items: []
  - m_Id: 5123265227464705
    m_Localized: "Sopla una l\xEDnea de 3 casillas y empuja a todos en ella, a menudo hacia otros golpes."
    m_Metadata:
      m_Items: []
  - m_Id: 5123265382653952
