    m_Metadata:
      m_Items: []
  - m_Id: 5123261129629697
    m_Localized: "Marca 2 casillas seguidas a 2-4 en l\xEDnea recta y las maldice en su siguiente turno: 1 de da\xF1o y Expuesto (recibe 1 m\xE1s de cada golpe)."
    m_Metadata:
      m_Items: []
  - m_Id: 5123261301596160
