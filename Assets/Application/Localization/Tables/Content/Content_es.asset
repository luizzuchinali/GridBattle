    m_Metadata:
      m_Items: []
  - m_Id: 5123265382653953
    m_Localized: "\xC9lite. Barre 3 casillas delante de \xE9l y carga desde lejos para empujarte."
    m_Metadata:
      m_Items: []
  - m_Id: 5123265550426112
