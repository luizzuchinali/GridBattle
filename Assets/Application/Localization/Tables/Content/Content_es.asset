    m_Metadata:
      m_Items: []
  - m_Id: 5123260961857536
    m_Localized: Chillido
    m_Metadata:
      m_Items: []
  - m_Id: 5123260961857537
    m_Localized: "Marca una cruz de 5 casillas a hasta 2 y chilla contra ella en su siguiente turno: 1 de da\xF1o y empuja 1 casilla."
    m_Metadata:
      m_Items: []
  - m_Id: 5123261129629696
