  m_Name: Content_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 84108cdf327ab9342bf94b3442a30042, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 4496571990016
    m_Localized: Debilitado
    m_Metadata:
      m_Items: []
  - m_Id: 4496651681792
    m_Localized: "Inflige un 50% menos de da\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 4497024974848
    m_Localized: Armadura de Espinas
    m_Metadata:
      m_Items: []
  - m_Id: 4497024974849
    m_Localized: "Al recibir un ataque, devuelve da\xF1o al atacante."
    m_Metadata:
      m_Items: []
  - m_Id: 4497381490688
    m_Localized: Robo de Vida
    m_Metadata:
      m_Items: []
  - m_Id: 4497381490689
    m_Localized: "Recupera parte del da\xF1o infligido como vida."
    m_Metadata:
      m_Items: []
  - m_Id: 4497729617920
    m_Localized: "Regeneraci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 4497729617921
    m_Localized: Recupera vida al inicio de cada turno.
    m_Metadata:
      m_Items: []
  - m_Id: 4498077745152
    m_Localized: Escudo
    m_Metadata:
      m_Items: []
  - m_Id: 4498077745153
    m_Localized: "Vida temporal que absorbe da\xF1o antes que la vida real."
    m_Metadata:
      m_Items: []
  - m_Id: 4498425872384
    m_Localized: Envenenado
    m_Metadata:
      m_Items: []
  - m_Id: 4498425872385
    m_Localized: "Recibe da\xF1o al inicio de cada turno."
    m_Metadata:
      m_Items: []
  - m_Id: 7824852877312
    m_Localized: Blindado
    m_Metadata:
      m_Items: []
  - m_Id: 7824865460224
    m_Localized: "Reduce el da\xF1o de cada golpe recibido."
    m_Metadata:
      m_Items: []
  - m_Id: 7825255530496
    m_Localized: Cuerpo a cuerpo
    m_Metadata:
      m_Items: []
  - m_Id: 7825255530497
    m_Localized: Te persigue y ataca de cerca.
    m_Metadata:
      m_Items: []
  - m_Id: 7825603657728
    m_Localized: Enjambre
    m_Metadata:
      m_Items: []
  - m_Id: 7825603657729
    m_Localized: "Fr\xE1gil y r\xE1pido, y llega en grupo."
    m_Metadata:
      m_Items: []
  - m_Id: 7825955979264
    m_Localized: Tirador
    m_Metadata:
      m_Items: []
  - m_Id: 7825955979265
    m_Localized: Ataca desde lejos e intenta mantener la distancia.
    m_Metadata:
      m_Items: []
  - m_Id: 7826312495104
    m_Localized: Apoyo
    m_Metadata:
      m_Items: []
  - m_Id: 7826312495105
    m_Localized: Cura o fortalece a sus aliados. Objetivo prioritario.
    m_Metadata:
      m_Items: []
  - m_Id: 7826656428032
    m_Localized: Invocador
    m_Metadata:
      m_Items: []
  - m_Id: 7826656428033
    m_Localized: Invoca nuevos enemigos durante el combate.
    m_Metadata:
      m_Items: []
  - m_Id: 7827000360960
    m_Localized: Controlador
    m_Metadata:
      m_Items: []
  - m_Id: 7827000360961
    m_Localized: "Te aplica estados negativos o te mueve por la cuadr\xEDcula."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462912
    m_Localized: Goblin
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462913
    m_Localized: Te persigue y ataca de cerca.
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462914
    m_Localized: Slime
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462915
    m_Localized: Lento y resistente. Avanza hacia ti y ataca de cerca.
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462916
    m_Localized: Rata
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462917
    m_Localized: "R\xE1pida y fr\xE1gil. Se acerca deprisa y muerde."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462918
    m_Localized: "Murci\xE9lago ojo"
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462919
    m_Localized: "R\xE1pido y fr\xE1gil. Vuela hacia ti y ataca de cerca."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462920
    m_Localized: Calavera de fuego
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462921
    m_Localized: Ataca desde lejos e intenta mantener esa distancia.
    m_Metadata:
      m_Items: []
  - m_Id: 7828212514816
    m_Localized: "Cham\xE1n goblin"
    m_Metadata:
      m_Items: []
  - m_Id: 7828212514817
    m_Localized: "Cura y protege a los aliados heridos y se mantiene lejos de ti. Elim\xEDnalo primero."
    m_Metadata:
      m_Items: []
  - m_Id: 7828325761024
    m_Localized: Reina rata
    m_Metadata:
      m_Items: []
  - m_Id: 7828325761025
    m_Localized: Invoca ratas para que luchen por ella y se mantiene lejos de ti.
    m_Metadata:
      m_Items: []
  - m_Id: 7828430618624
    m_Localized: Ojo maldito
    m_Metadata:
      m_Items: []
  - m_Id: 7828430618625
    m_Localized: Te debilita desde lejos y luego se acerca para atacar.
    m_Metadata:
      m_Items: []
  - m_Id: 7828539670528
    m_Localized: Goblin blindado
    m_Metadata:
      m_Items: []
  - m_Id: 7828539670529
    m_Localized: "La armadura bloquea parte de cada golpe, as\xED que los ataques d\xE9biles apenas le hacen da\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 7828652916736
    m_Localized: Slime regenerante
    m_Metadata:
      m_Items: []
  - m_Id: 7828652916737
    m_Localized: "Recupera vida cada turno. Haz da\xF1o r\xE1pido, antes de que se cure."
    m_Metadata:
      m_Items: []
  - m_Id: 7828757774336
    m_Localized: Rata espinosa
    m_Metadata:
      m_Items: []
  - m_Id: 7828757774337
    m_Localized: "Hiere a quien lo golpea. Ataca desde lejos o usa da\xF1o con el tiempo."
    m_Metadata:
      m_Items: []
  - m_Id: 7840745095168
    m_Localized: Golpe
    m_Metadata:
      m_Items: []
  - m_Id: 7840745095169
    m_Localized: "Un golpe r\xE1pido contra un enemigo adyacente."
    m_Metadata:
      m_Items: []
  - m_Id: 7841101611008
    m_Localized: Embestida con Escudo
    m_Metadata:
      m_Items: []
  - m_Id: 7841101611009
    m_Localized: "Embiste con el escudo y golpea una l\xEDnea de enemigos."
    m_Metadata:
      m_Items: []
  - m_Id: 7841487486976
    m_Localized: Bola de Fuego
    m_Metadata:
      m_Items: []
  - m_Id: 7841487486977
    m_Localized: "Lanza una bola de fuego que quema a los enemigos de un \xE1rea, desde cualquier punto de la cuadr\xEDcula."
    m_Metadata:
      m_Items: []
  - m_Id: 7841844002816
    m_Localized: Nova de Hielo
    m_Metadata:
      m_Items: []
  - m_Id: 7841844002817
    m_Localized: "Una explosi\xF3n de hielo que golpea a los enemigos alrededor del objetivo."
    m_Metadata:
      m_Items: []
  - m_Id: 7842200518656
    m_Localized: "Tormenta El\xE9ctrica"
    m_Metadata:
      m_Items: []
  - m_Id: 7842200518657
    m_Localized: Un rayo que se abre en cono desde el objetivo.
    m_Metadata:
      m_Items: []
  - m_Id: 7842586394624
    m_Localized: Daga Arrojadiza
    m_Metadata:
      m_Items: []
  - m_Id: 7842586394625
    m_Localized: Lanza una daga a un enemigo lejano.
    m_Metadata:
      m_Items: []
  - m_Id: 7842947104768
    m_Localized: Bomba de Humo
    m_Metadata:
      m_Items: []
  - m_Id: 7842947104769
    m_Localized: Lanza una bomba de humo a un enemigo a tu lado.
    m_Metadata:
      m_Items: []
  - m_Id: 7843299426304
    m_Localized: Daga Envenenada
    m_Metadata:
      m_Items: []
  - m_Id: 7843299426305
    m_Localized: "Una daga envenenada que atraviesa una l\xEDnea de enemigos."
    m_Metadata:
      m_Items: []
  - m_Id: 7843660136448
    m_Localized: "L\xEDnea Venenosa"
    m_Metadata:
      m_Items: []
  - m_Id: 7843660136449
    m_Localized: "Un largo rastro de veneno que golpea a todos los enemigos en l\xEDnea."
    m_Metadata:
      m_Items: []
  - m_Id: 10290159910912
    m_Localized: Tu primera batalla
    m_Metadata:
      m_Items: []
  - m_Id: 10290247991296
    m_Localized: "Toca una celda resaltada para moverte o a un enemigo al alcance para atacar; cada acci\xF3n da un turno a los enemigos. Derrotarlos da XP: llena la barra para subir de nivel."
    m_Metadata:
      m_Items: []
  - m_Id: 10290373820416
    m_Localized: Elige tu camino
    m_Metadata:
      m_Items: []
  - m_Id: 10290373820417
    m_Localized: 'Toca un nodo para ver su vista previa: el tipo y, en las batallas, el XP, los roles de los enemigos y el terreno. Luego confirma para entrar.'
    m_Metadata:
      m_Items: []
  - m_Id: 10290495455232
    m_Localized: "\xA1Subiste de nivel!"
    m_Metadata:
      m_Items: []
  - m_Id: 10290495455233
    m_Localized: "El juego est\xE1 en pausa: elige 1 de 3 talentos para formar tu build. Tambi\xE9n puedes sortear de nuevo la oferta, vetar un talento u omitirla."
    m_Metadata:
      m_Items: []
  - m_Id: 10290604507136
    m_Localized: La vida se mantiene
    m_Metadata:
      m_Items: []
  - m_Id: 10290604507137
    m_Localized: "Tu vida se mantiene en la siguiente batalla. Solo se recupera en nodos de curaci\xF3n o con tu build; vig\xEDlala al planear tu ruta."
    m_Metadata:
      m_Items: []
  - m_Id: 10290717753344
    m_Localized: "Nodo de curaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 10290717753345
    m_Localized: "Aqu\xED recuperas vida. Planea tu ruta para llegar a uno antes de que se acabe tu vida."
    m_Metadata:
      m_Items: []
  - m_Id: 10290826805248
    m_Localized: Nodo de talento
    m_Metadata:
      m_Items: []
  - m_Id: 10290826805249
    m_Localized: "Aqu\xED puedes obtener un talento fuera de las subidas de nivel, a cambio de un coste. Aseg\xFArate de que valga la pena."
    m_Metadata:
      m_Items: []
  - m_Id: 10290944245760
    m_Localized: Consumibles
    m_Metadata:
      m_Items: []
  - m_Id: 10290944245761
    m_Localized: "Los consumibles son de un solo uso y solo funcionan en batalla. Usar uno no gasta tu acci\xF3n, pero solo puedes usar uno por turno."
    m_Metadata:
      m_Items: []
  - m_Id: 10291057491968
    m_Localized: Detalles
    m_Metadata:
      m_Items: []
  - m_Id: 10291057491969
    m_Localized: "Mant\xE9n pulsado (clic derecho en PC) un personaje para ver sus atributos, habilidades y estados activos. Nunca gasta tu turno: cierra la ventana con la X."
    m_Metadata:
      m_Items: []
  - m_Id: 10291187515392
    m_Localized: Habilidades
    m_Metadata:
      m_Items: []
  - m_Id: 10291187515393
    m_Localized: "Toca el bot\xF3n de una habilidad y luego una celda resaltada para usarla; t\xF3calo de nuevo para cancelar. Las habilidades tienen una recarga que se cuenta en tus acciones."
    m_Metadata:
      m_Items: []
  - m_Id: 141742633615360
    m_Localized: "Poci\xF3n de Curaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 141742713307136
    m_Localized: "Restaura 30 de vida. Usarla no gasta tu acci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 141743153709056
    m_Localized: Bomba
    m_Metadata:
      m_Items: []
  - m_Id: 141743153709057
    m_Localized: "L\xE1nzala hasta 3 casillas de distancia: causa 15 de da\xF1o a cada enemigo en un \xE1rea de 3x3. No gasta tu acci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 141743547973632
    m_Localized: "T\xF3nico de Regeneraci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 141743547973633
    m_Localized: "Recupera vida con el tiempo durante 3 turnos. No gasta tu acci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 142151209156608
    m_Localized: Roca
    m_Metadata:
      m_Items: []
  - m_Id: 142151209156609
    m_Localized: 'Los escombros bloquean el paso: nadie puede ocupar esta casilla ni cruzarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 142151704084480
    m_Localized: Fuego
    m_Metadata:
      m_Items: []
  - m_Id: 142151704084481
    m_Localized: Quema a quien termine su turno sobre ella.
    m_Metadata:
      m_Items: []
  - m_Id: 142152127709184
    m_Localized: Pantano Venenoso
    m_Metadata:
      m_Items: []
  - m_Id: 142152127709185
    m_Localized: Envenena a quien termine su turno sobre ella.
    m_Metadata:
      m_Items: []
  - m_Id: 142152563916800
    m_Localized: Santuario Curativo
    m_Metadata:
      m_Items: []
  - m_Id: 142152563916801
    m_Localized: "Otorga Regeneraci\xF3n a quien termine su turno sobre ella."
    m_Metadata:
      m_Items: []
  - m_Id: 142153050456064
    m_Localized: Piedra Protectora
    m_Metadata:
      m_Items: []
  - m_Id: 142153050456065
    m_Localized: Otorga un Escudo a quien termine su turno sobre ella.
    m_Metadata:
      m_Items: []
  - m_Id: 151679795429376
    m_Localized: Rey Goblin
    m_Metadata:
      m_Items: []
  - m_Id: 151679891898368
    m_Localized: "Jefe final provisional: un rey goblin m\xE1s fuerte que cualquier goblin."
    m_Metadata:
      m_Items: []
  - m_Id: 151679891898369
    m_Localized: Te embiste y golpea fuerte. Llega con dos guardias blindados.
    m_Metadata:
      m_Items: []
  - m_Id: 151680038699008
    m_Localized: Guardia Goblin
    m_Metadata:
      m_Items: []
  - m_Id: 151680038699009
    m_Localized: Escolta provisional del jefe final. Blindado.
    m_Metadata:
      m_Items: []
  - m_Id: 151680038699010
    m_Localized: "Te persigue y ataca de cerca. Recibe menos da\xF1o de cada golpe."
    m_Metadata:
      m_Items: []
  - m_Id: 218482187194368
    m_Localized: Ataque
    m_Metadata:
      m_Items: []
  - m_Id: 218482434658304
    m_Localized: Defensa
    m_Metadata:
      m_Items: []
  - m_Id: 218482585653248
    m_Localized: "Cr\xEDtico"
    m_Metadata:
      m_Items: []
  - m_Id: 218482719870976
    m_Localized: Habilidades
    m_Metadata:
      m_Items: []
  - m_Id: 218482841505792
    m_Localized: "Recuperaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 218482958946304
    m_Localized: Utilidad
    m_Metadata:
      m_Items: []
  - m_Id: 218483076386816
    m_Localized: "Guardi\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 218483202215936
    m_Localized: Arcano
    m_Metadata:
      m_Items: []
  - m_Id: 218483328045056
    m_Localized: Sombra
    m_Metadata:
      m_Items: []
  - m_Id: 218483445485568
    m_Localized: Veneno
    m_Metadata:
      m_Items: []
  - m_Id: 218484057853952
    m_Localized: Vitalidad
    m_Metadata:
      m_Items: []
  - m_Id: 218484057853953
    m_Localized: "+10 de vida m\xE1xima por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218484464701440
    m_Localized: Hoja Afilada
    m_Metadata:
      m_Items: []
  - m_Id: 218484464701441
    m_Localized: "+2 de da\xF1o del ataque b\xE1sico por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218484909297664
    m_Localized: Ojo Agudo
    m_Metadata:
      m_Items: []
  - m_Id: 218484909297665
    m_Localized: "+5% de probabilidad de cr\xEDtico por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218485311950848
    m_Localized: "Precisi\xF3n Letal"
    m_Metadata:
      m_Items: []
  - m_Id: 218485311950849
    m_Localized: "+0,25x al multiplicador de da\xF1o cr\xEDtico por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218485693632512
    m_Localized: "Perforaci\xF3n de Armadura"
    m_Metadata:
      m_Items: []
  - m_Id: 218485693632513
    m_Localized: "Ignora el 10% de la defensa del objetivo por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218486079508480
    m_Localized: Robustez
    m_Metadata:
      m_Items: []
  - m_Id: 218486079508481
    m_Localized: "+1 de defensa por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218486490550272
    m_Localized: "Maestr\xEDa en Habilidades"
    m_Metadata:
      m_Items: []
  - m_Id: 218486490550273
    m_Localized: "+10% de da\xF1o en habilidades ofensivas por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218486876426240
    m_Localized: Largo Alcance
    m_Metadata:
      m_Items: []
  - m_Id: 218486876426241
    m_Localized: "+1 de alcance de habilidades por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218487270690816
    m_Localized: "Recuperaci\xF3n R\xE1pida"
    m_Metadata:
      m_Items: []
  - m_Id: 218487270690817
    m_Localized: "Las habilidades se recuperan 1 acci\xF3n antes por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218487669149696
    m_Localized: Armadura de Espinas
    m_Metadata:
      m_Items: []
  - m_Id: 218487669149697
    m_Localized: "Al recibir un ataque, devuelve 2 de da\xF1o al atacante por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218488046637056
    m_Localized: Robo de Vida
    m_Metadata:
      m_Items: []
  - m_Id: 218488046637057
    m_Localized: "Recupera el 5% del da\xF1o infligido como vida por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218488432513024
    m_Localized: "Regeneraci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 218488432513025
    m_Localized: "Recupera 2 de vida al inicio de cada uno de tus turnos por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218488814194688
    m_Localized: "M\xE1s Opciones"
    m_Metadata:
      m_Items: []
  - m_Id: 218488814194689
    m_Localized: "+1 opci\xF3n de talento en cada oferta por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218489191682048
    m_Localized: Favor de la Fortuna
    m_Metadata:
      m_Items: []
  - m_Id: 218489191682049
    m_Localized: "+1 reroll de ofertas de talento por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218489581752320
    m_Localized: Desterrador
    m_Metadata:
      m_Items: []
  - m_Id: 218489581752321
    m_Localized: "+1 destierro de ofertas de talento por acumulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 218489829216256
    m_Localized: Vitalidad
    m_Metadata:
      m_Items: []
  - m_Id: 218489829216257
    m_Localized: "+10 de vida m\xE1xima por rango."
    m_Metadata:
      m_Items: []
  - m_Id: 218490064097280
    m_Localized: Hoja Afilada
    m_Metadata:
      m_Items: []
  - m_Id: 218490064097281
    m_Localized: "+2 de da\xF1o del ataque b\xE1sico por rango."
    m_Metadata:
      m_Items: []
  - m_Id: 218490298978304
    m_Localized: Ojo Agudo
    m_Metadata:
      m_Items: []
  - m_Id: 218490298978305
    m_Localized: "+5% de probabilidad de cr\xEDtico por rango."
    m_Metadata:
      m_Items: []
  - m_Id: 218490542247936
