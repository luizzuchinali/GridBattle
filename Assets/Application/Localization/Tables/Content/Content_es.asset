      m_Items: []
  - m_Id: 444085320155136
    m_Localized: "R\xE1faga de Viento"
    m_Metadata:
      m_Items: []
  - m_Id: 444085320155137
    m_Localized: "Una r\xE1faga de viento a una casilla a hasta 3 en l\xEDnea recta: 1 de da\xF1o y empuja al objetivo 1 casilla lejos de ti."
