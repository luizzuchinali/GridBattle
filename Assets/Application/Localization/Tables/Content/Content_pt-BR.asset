      m_Items: []
  - m_Id: 444085320155136
    m_Localized: Rajada de Vento
    m_Metadata:
      m_Items: []
  - m_Id: 444085320155137
    m_Localized: "Uma rajada de vento numa casa a at\xE9 3 em linha reta: 1 de dano e empurra o alvo 1 casa para longe de voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 444085714419712
    m_Localized: Gancho
    m_Metadata:
      m_Items: []
  - m_Id: 444085714419713
    m_Localized: "Lan\xE7a um gancho num inimigo a 2-3 casas em linha reta: 1 de dano e o puxa at\xE9 3 casas em sua dire\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 444086129655808
    m_Localized: Gancho
    m_Metadata:
      m_Items: []
  - m_Id: 444086129655809
    m_Localized: "Marca uma casa a 2-4 em linha reta e a fisga no pr\xF3ximo turno: 1 de dano e puxa quem estiver l\xE1 at\xE9 3 casas em dire\xE7\xE3o ao goblin."
    m_Metadata:
      m_Items: []
  - m_Id: 444086486171648
    m_Localized: Onda de Choque
    m_Metadata:
      m_Items: []
  - m_Id: 444086486171649
    m_Localized: "Marca uma linha de 4 casas \xE0 frente e lan\xE7a uma onda de choque no pr\xF3ximo turno: 2 de dano e arremessa todos nela 2 casas para tr\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 444086842687488
    m_Localized: "For\xE7a Bruta"
    m_Metadata:
      m_Items: []
  - m_Id: 444086842687489
    m_Localized: "Desbloqueia Abalo S\xEDsmico: racha o ch\xE3o numa linha de 3 casas \xE0 sua frente, atingindo e empurrando todos nela."
    m_Metadata:
      m_Items: []
  - m_Id: 444087660576768
    m_Localized: Goblin arpoador
    m_Metadata:
      m_Items: []
  - m_Id: 444087660576769
    m_Localized: "Fisga voc\xEA de longe e arrasta voc\xEA para perto do grupo."
    m_Metadata:
      m_Items: []
  - m_Id: 458931054968832
    m_Localized: "Brig\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 458931294044160
    m_Localized: Elemental
    m_Metadata:
      m_Items: []
  - m_Id: 458931742834688
    m_Localized: Queimando
    m_Metadata:
      m_Items: []
  - m_Id: 458931742834689
    m_Localized: "Leva 1 de dano no in\xEDcio de cada um dos seus turnos."
    m_Metadata:
      m_Items: []
  - m_Id: 458932103544832
    m_Localized: Veneno letal
    m_Metadata:
      m_Items: []
  - m_Id: 458932103544833
    m_Localized: "Sofre 1 de dano mais 5% da sua vida m\xE1xima no in\xEDcio do seu turno e causa 6% menos dano, por pilha (at\xE9 5)."
    m_Metadata:
      m_Items: []
