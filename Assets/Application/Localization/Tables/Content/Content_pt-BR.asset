MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Content_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 84108cdf327ab9342bf94b3442a30042, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 4496571990016
    m_Localized: Fraquejado
    m_Metadata:
      m_Items: []
  - m_Id: 4496651681792
    m_Localized: Causa 1 de dano a menos em cada golpe.
    m_Metadata:
      m_Items: []
  - m_Id: 4497024974848
    m_Localized: Armadura de Espinhos
    m_Metadata:
      m_Items: []
  - m_Id: 4497024974849
    m_Localized: Causa 1 de dano em quem o atinge.
    m_Metadata:
      m_Items: []
  - m_Id: 4497381490688
    m_Localized: Roubo de Vida
    m_Metadata:
      m_Items: []
  - m_Id: 4497381490689
    m_Localized: Recupera parte do dano causado como vida.
    m_Metadata:
      m_Items: []
  - m_Id: 4497729617920
    m_Localized: "Regenera\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 4497729617921
    m_Localized: "Recupera 1 PV no in\xEDcio de cada um dos seus turnos."
    m_Metadata:
      m_Items: []
  - m_Id: 4498077745152
    m_Localized: Escudo
    m_Metadata:
      m_Items: []
  - m_Id: 4498077745153
    m_Localized: "Absorve o pr\xF3ximo 1 de dano."
    m_Metadata:
      m_Items: []
  - m_Id: 4498425872384
    m_Localized: Envenenado
    m_Metadata:
      m_Items: []
  - m_Id: 4498425872385
    m_Localized: "Leva 1 de dano no in\xEDcio de cada um dos seus turnos."
    m_Metadata:
      m_Items: []
  - m_Id: 7824852877312
    m_Localized: Blindado
    m_Metadata:
      m_Items: []
  - m_Id: 7824865460224
    m_Localized: "Bloqueia 1 de dano de cada golpe. Colis\xF5es ignoram a armadura."
    m_Metadata:
      m_Items: []
  - m_Id: 7825255530496
    m_Localized: Corpo a corpo
    m_Metadata:
      m_Items: []
  - m_Id: 7825255530497
    m_Localized: "Persegue voc\xEA e ataca de perto."
    m_Metadata:
      m_Items: []
  - m_Id: 7825603657728
    m_Localized: Enxame
    m_Metadata:
      m_Items: []
  - m_Id: 7825603657729
    m_Localized: "Fr\xE1gil e r\xE1pido, e aparece em quantidade."
    m_Metadata:
      m_Items: []
  - m_Id: 7825955979264
    m_Localized: Atirador
    m_Metadata:
      m_Items: []
  - m_Id: 7825955979265
    m_Localized: "Ataca de longe e tenta manter a dist\xE2ncia."
    m_Metadata:
      m_Items: []
  - m_Id: 7826312495104
    m_Localized: Suporte
    m_Metadata:
      m_Items: []
  - m_Id: 7826312495105
    m_Localized: "Cura ou fortalece os aliados. Alvo priorit\xE1rio."
    m_Metadata:
      m_Items: []
  - m_Id: 7826656428032
    m_Localized: Invocador
    m_Metadata:
      m_Items: []
  - m_Id: 7826656428033
    m_Localized: Invoca novos inimigos durante a batalha.
    m_Metadata:
      m_Items: []
  - m_Id: 7827000360960
    m_Localized: Controlador
    m_Metadata:
      m_Items: []
  - m_Id: 7827000360961
    m_Localized: "Aplica estados negativos em voc\xEA ou move voc\xEA pelo grid."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462912
    m_Localized: Goblin
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462913
    m_Localized: "Chega perto e acerta o porrete numa casa adjacente no pr\xF3ximo turno."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462914
    m_Localized: Slime
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462915
    m_Localized: "Lento e resistente. Respinga \xE1cido na casa da frente e nos lados."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462916
    m_Localized: Rato
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462917
    m_Localized: "R\xE1pido e fr\xE1gil. Se aproxima depressa e morde uma casa adjacente."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462918
    m_Localized: Morcego-olho
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462919
    m_Localized: "R\xE1pido e fr\xE1gil. Mergulha nas casas da diagonal e, de tempos em tempos, grita contra todas as casas ao redor, empurrando quem estiver nelas."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462920
    m_Localized: "Cr\xE2nio de fogo"
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462921
    m_Localized: "Mant\xE9m dist\xE2ncia e dispara setas flamejantes em linha reta que deixam voc\xEA Queimando."
    m_Metadata:
      m_Items: []
  - m_Id: 7828212514816
    m_Localized: "Xam\xE3 goblin"
    m_Metadata:
      m_Items: []
  - m_Id: 7828212514817
    m_Localized: "Cura e protege os aliados feridos e eletrifica voc\xEA de longe. Elimine-o primeiro."
    m_Metadata:
      m_Items: []
  - m_Id: 7828325761024
    m_Localized: Rainha dos ratos
    m_Metadata:
      m_Items: []
  - m_Id: 7828325761025
    m_Localized: "Invoca ratos para lutar por ela e guincha para empurrar voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 7828430618624
    m_Localized: Olho maldito
    m_Metadata:
      m_Items: []
  - m_Id: 7828430618625
    m_Localized: "Enfraquece voc\xEA de longe e amaldi\xE7oa uma linha, deixando voc\xEA Exposto."
    m_Metadata:
      m_Items: []
  - m_Id: 7828539670528
    m_Localized: Goblin blindado
    m_Metadata:
      m_Items: []
  - m_Id: 7828539670529
    m_Localized: "A armadura bloqueia 1 de dano de cada golpe: empurre-o contra algo, colis\xF5es ignoram a armadura."
    m_Metadata:
      m_Items: []
  - m_Id: 7828652916736
    m_Localized: Slime regenerante
    m_Metadata:
      m_Items: []
  - m_Id: 7828652916737
    m_Localized: "Recupera 1 PV a cada turno. Acabe com ele r\xE1pido."
    m_Metadata:
      m_Items: []
  - m_Id: 7828757774336
    m_Localized: Rato espinhoso
    m_Metadata:
      m_Items: []
  - m_Id: 7828757774337
    m_Localized: "Causa 1 de dano em quem o atinge. Melhor empurr\xE1-lo contra outros: colis\xF5es n\xE3o espetam."
    m_Metadata:
      m_Items: []
  - m_Id: 7840745095168
    m_Localized: Golpe
    m_Metadata:
      m_Items: []
  - m_Id: 7840745095169
    m_Localized: Golpeia um inimigo adjacente e o empurra 1 casa.
    m_Metadata:
      m_Items: []
  - m_Id: 7841101611008
    m_Localized: Investida com Escudo
    m_Metadata:
      m_Items: []
  - m_Id: 7841101611009
    m_Localized: "Avan\xE7a at\xE9 3 casas em linha reta. O inimigo no fim leva 1 de dano e \xE9 empurrado 1 casa."
    m_Metadata:
      m_Items: []
  - m_Id: 7841487486976
    m_Localized: Bola de Fogo
    m_Metadata:
      m_Items: []
  - m_Id: 7841487486977
    m_Localized: "Lan\xE7a uma bola de fogo numa casa a 2-3: 2 de dano, e a casa queima por 2 rodadas (1 de dano em quem terminar o turno nela)."
    m_Metadata:
      m_Items: []
  - m_Id: 7841844002816
    m_Localized: Nova de Gelo
    m_Metadata:
      m_Items: []
  - m_Id: 7841844002817
    m_Localized: "Congela todos ao seu redor: 1 de dano, e no pr\xF3ximo turno deles n\xE3o podem andar nem usar skills. Um inimigo congelado perde o golpe preparado."
    m_Metadata:
      m_Items: []
  - m_Id: 7842200518656
    m_Localized: "Tempestade El\xE9trica"
    m_Metadata:
      m_Items: []
  - m_Id: 7842200518657
    m_Localized: "Raios do c\xE9u numa cruz de casas a 2-4 (n\xE3o precisa de linha de vis\xE3o): 1 de dano e atordoa, cancelando os golpes preparados. Canalizada: gasta tamb\xE9m o andar do turno (use antes de andar)."
    m_Metadata:
      m_Items: []
  - m_Id: 7842586394624
    m_Localized: Adaga de Arremesso
    m_Metadata:
      m_Items: []
  - m_Id: 7842586394625
    m_Localized: "Arremessa uma adaga num inimigo a 2-4 casas em linha ou diagonal: 1 de dano e Exposto (leva 1 a mais de cada golpe) at\xE9 o seu pr\xF3ximo turno."
    m_Metadata:
      m_Items: []
  - m_Id: 7842947104768
    m_Localized: "Bomba de Fuma\xE7a"
    m_Metadata:
      m_Items: []
  - m_Id: 7842947104769
    m_Localized: "Estoura uma bomba de fuma\xE7a ao seu redor: 1 de dano e cega todos ao seu redor. Inimigos cegos perdem o golpe preparado e n\xE3o podem preparar outro no pr\xF3ximo turno."
    m_Metadata:
      m_Items: []
  - m_Id: 7843299426304
    m_Localized: Adaga Envenenada
    m_Metadata:
      m_Items: []
  - m_Id: 7843299426305
    m_Localized: "Arremessa uma adaga numa casa a at\xE9 3 em linha reta: 1 de dano e Envenenado (1 de dano no in\xEDcio de cada um dos 2 pr\xF3ximos turnos dele)."
    m_Metadata:
      m_Items: []
  - m_Id: 7843660136448
    m_Localized: Linha Venenosa
    m_Metadata:
      m_Items: []
  - m_Id: 7843660136449
    m_Localized: "Derrama veneno numa linha de 4 casas \xE0 sua frente: 1 de dano, Envenenado, e as casas viram um p\xE2ntano venenoso por 2 rodadas."
    m_Metadata:
      m_Items: []
  - m_Id: 10290159910912
    m_Localized: Sua primeira batalha
    m_Metadata:
      m_Items: []
  - m_Id: 10290247991296
    m_Localized: "Em cada turno voc\xEA anda uma vez e usa uma skill, na ordem que quiser. Os inimigos marcam as casas que v\xE3o golpear no pr\xF3ximo turno: saia das marcas, ou empurre, puxe, atordoe ou congele os inimigos. Toque em si mesmo ou em Encerrar para terminar."
    m_Metadata:
      m_Items: []
  - m_Id: 10290373820416
    m_Localized: Escolha seu caminho
    m_Metadata:
      m_Items: []
  - m_Id: 10290373820417
    m_Localized: "Toque em um n\xF3 para ver a pr\xE9via: o tipo e, nas batalhas, o XP, os pap\xE9is dos inimigos e o terreno. Depois confirme para entrar."
    m_Metadata:
      m_Items: []
  - m_Id: 10290495455232
    m_Localized: "Voc\xEA subiu de n\xEDvel!"
    m_Metadata:
      m_Items: []
  - m_Id: 10290495455233
    m_Localized: "O jogo est\xE1 pausado: escolha 1 de 3 talentos para montar sua build. Voc\xEA tamb\xE9m pode rerrolar a oferta, banir um talento ou pular."
    m_Metadata:
      m_Items: []
  - m_Id: 10290604507136
    m_Localized: "A vida se mant\xE9m"
    m_Metadata:
      m_Items: []
  - m_Id: 10290604507137
    m_Localized: "Sua vida se mant\xE9m na pr\xF3xima batalha e n\xE3o volta ao subir de n\xEDvel. Descanse nos acampamentos para se curar e planeje sua rota em torno deles."
    m_Metadata:
      m_Items: []
  - m_Id: 10290717753344
    m_Localized: Acampamento
    m_Metadata:
      m_Items: []
  - m_Id: 10290717753345
    m_Localized: "No acampamento voc\xEA descansa para recuperar vida ou treina para transformar uma das suas skills numa vers\xE3o mais forte. Escolha o que a sua run precisa."
    m_Metadata:
      m_Items: []
  - m_Id: 10290826805248
    m_Localized: "N\xF3 de talento"
    m_Metadata:
      m_Items: []
  - m_Id: 10290826805249
    m_Localized: "Aqui voc\xEA pode obter um talento fora das subidas de n\xEDvel, pagando com vida m\xE1xima. Veja se vale a pena."
    m_Metadata:
      m_Items: []
  - m_Id: 10290944245760
    m_Localized: "Consum\xEDveis"
    m_Metadata:
      m_Items: []
  - m_Id: 10290944245761
    m_Localized: "Consum\xEDveis s\xE3o de uso \xFAnico e s\xF3 funcionam em batalha. Usar um n\xE3o gasta sua a\xE7\xE3o, mas s\xF3 \xE9 poss\xEDvel usar um por turno."
    m_Metadata:
      m_Items: []
  - m_Id: 10291057491968
    m_Localized: Detalhes
    m_Metadata:
      m_Items: []
  - m_Id: 10291057491969
    m_Localized: 'Segure (clique direito no PC) em um personagem para ver atributos, skills e estados ativos. Isso nunca gasta seu turno: feche a janela no X.'
    m_Metadata:
      m_Items: []
  - m_Id: 10291187515392
    m_Localized: Skills
    m_Metadata:
      m_Items: []
  - m_Id: 10291187515393
    m_Localized: "Toque numa skill e depois numa casa destacada para mirar: a pr\xE9via mostra o dano, os empurr\xF5es e onde os golpes marcados v\xE3o cair. Toque de novo na mesma casa ou em Confirmar para usar, ou em Cancelar para escolher outra vez. As skills t\xEAm uma recarga contada nos seus turnos."
    m_Metadata:
      m_Items: []
  - m_Id: 141742633615360
    m_Localized: "Po\xE7\xE3o de Cura"
    m_Metadata:
      m_Items: []
  - m_Id: 141742713307136
    m_Localized: "Restaura 4 de vida. Us\xE1-la n\xE3o gasta a sua a\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 141743153709056
    m_Localized: Bomba
    m_Metadata:
      m_Items: []
  - m_Id: 141743153709057
    m_Localized: "Arremesse at\xE9 3 casas de dist\xE2ncia, com linha de vis\xE3o: causa 2 de dano em cada inimigo numa \xE1rea 3x3. N\xE3o gasta a sua a\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 141743547973632
    m_Localized: "T\xF4nico de Regenera\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 141743547973633
    m_Localized: "Recupera 1 PV no in\xEDcio de cada um dos seus 3 pr\xF3ximos turnos. N\xE3o gasta a sua a\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 142151209156608
    m_Localized: Rocha
    m_Metadata:
      m_Items: []
  - m_Id: 142151209156609
    m_Localized: "Entulho bloqueia o caminho: ningu\xE9m pode ocupar nem atravessar esta c\xE9lula."
    m_Metadata:
      m_Items: []
  - m_Id: 142151704084480
    m_Localized: Fogo
    m_Metadata:
      m_Items: []
  - m_Id: 142151704084481
    m_Localized: Causa 1 de dano em quem terminar o turno sobre ela.
    m_Metadata:
      m_Items: []
  - m_Id: 142152127709184
    m_Localized: "P\xE2ntano Venenoso"
    m_Metadata:
      m_Items: []
  - m_Id: 142152127709185
    m_Localized: Envenena quem terminar o turno sobre ela.
    m_Metadata:
      m_Items: []
  - m_Id: 142152563916800
    m_Localized: "Santu\xE1rio de Cura"
    m_Metadata:
      m_Items: []
  - m_Id: 142152563916801
    m_Localized: "Concede Regenera\xE7\xE3o a quem terminar o turno sobre ela."
    m_Metadata:
      m_Items: []
  - m_Id: 142153050456064
    m_Localized: Pedra Protetora
    m_Metadata:
      m_Items: []
  - m_Id: 142153050456065
    m_Localized: Concede um Escudo a quem terminar o turno sobre ela.
    m_Metadata:
      m_Items: []
  - m_Id: 151679795429376
    m_Localized: Rei Goblin
    m_Metadata:
      m_Items: []
  - m_Id: 151679891898368
    m_Localized: "Chefe final provis\xF3rio: um rei goblin mais forte que qualquer goblin."
    m_Metadata:
      m_Items: []
  - m_Id: 151679891898369
    m_Localized: "N\xE3o pode ser empurrado. Esmaga as casas ao redor e lan\xE7a ondas de choque em linha; as duas tamb\xE9m atingem os guardas."
    m_Metadata:
      m_Items: []
  - m_Id: 151680038699008
    m_Localized: Guarda Goblin
    m_Metadata:
      m_Items: []
  - m_Id: 151680038699009
    m_Localized: "Escolta provis\xF3ria do chefe final. Blindado."
    m_Metadata:
      m_Items: []
  - m_Id: 151680038699010
    m_Localized: "Escolta blindada do rei. Empurra voc\xEA, muitas vezes para a martelada do rei."
    m_Metadata:
      m_Items: []
  - m_Id: 218482187194368
    m_Localized: Ataque
    m_Metadata:
      m_Items: []
  - m_Id: 218482434658304
    m_Localized: Defesa
    m_Metadata:
      m_Items: []
  - m_Id: 218482585653248
    m_Localized: "Cr\xEDtico"
    m_Metadata:
      m_Items: []
  - m_Id: 218482719870976
    m_Localized: Habilidades
    m_Metadata:
      m_Items: []
  - m_Id: 218482841505792
    m_Localized: "Recupera\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 218482958946304
    m_Localized: Utilidade
    m_Metadata:
      m_Items: []
  - m_Id: 218483076386816
    m_Localized: "Guardi\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 218483202215936
    m_Localized: Arcano
    m_Metadata:
      m_Items: []
  - m_Id: 218483328045056
    m_Localized: Sombra
    m_Metadata:
      m_Items: []
  - m_Id: 218483445485568
    m_Localized: Veneno
    m_Metadata:
      m_Items: []
  - m_Id: 218484057853952
    m_Localized: Vitalidade
    m_Metadata:
      m_Items: []
  - m_Id: 218484057853953
    m_Localized: "+2 de vida m\xE1xima por n\xEDvel do talento."
    m_Metadata:
      m_Items: []
  - m_Id: 218486876426240
    m_Localized: Longo Alcance
    m_Metadata:
      m_Items: []
  - m_Id: 218486876426241
    m_Localized: +1 de alcance para as suas skills cujo alcance pode crescer.
    m_Metadata:
      m_Items: []
  - m_Id: 218488814194688
    m_Localized: "Mais Op\xE7\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 218488814194689
    m_Localized: "+1 op\xE7\xE3o de talento em cada oferta por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218489581752320
    m_Localized: Banidor
    m_Metadata:
      m_Items: []
  - m_Id: 218489581752321
    m_Localized: "+1 banimento das ofertas de talento por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218489829216256
    m_Localized: Vitalidade
    m_Metadata:
      m_Items: []
  - m_Id: 218489829216257
    m_Localized: "+2 de vida m\xE1xima por n\xEDvel do talento."
    m_Metadata:
      m_Items: []
  - m_Id: 218491444023296
    m_Localized: Longo Alcance
    m_Metadata:
      m_Items: []
  - m_Id: 218491444023297
    m_Localized: +1 de alcance para as suas skills cujo alcance pode crescer.
    m_Metadata:
      m_Items: []
  - m_Id: 218492639399936
    m_Localized: "Mais Op\xE7\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 218492639399937
    m_Localized: "+1 op\xE7\xE3o de talento em cada oferta por n\xEDvel do talento."
    m_Metadata:
      m_Items: []
  - m_Id: 218493130133504
    m_Localized: Banidor
    m_Metadata:
      m_Items: []
  - m_Id: 218493130133505
    m_Localized: "+1 banimento das ofertas de talento por n\xEDvel do talento."
    m_Metadata:
      m_Items: []
  - m_Id: 218493557952512
    m_Localized: Muralha
    m_Metadata:
      m_Items: []
  - m_Id: 218493557952513
    m_Localized: 'Desbloqueia Arremesso de Escudo: atinge um inimigo a 2-4 casas em linha reta e o empurra.'
    m_Metadata:
      m_Items: []
  - m_Id: 218493989965824
    m_Localized: "Grim\xF3rio"
    m_Metadata:
      m_Items: []
  - m_Id: 218493989965825
    m_Localized: "Desbloqueia Meteoro: 2 de dano numa \xE1rea 3x3 distante, empurrando todos para longe do centro."
    m_Metadata:
      m_Items: []
  - m_Id: 218494451339264
    m_Localized: Criomancia
    m_Metadata:
      m_Items: []
  - m_Id: 218494451339265
    m_Localized: "Desbloqueia Muralha de Gelo: ergue uma muralha de gelo de 3 casas que bloqueia o caminho, a vis\xE3o e os golpes."
    m_Metadata:
      m_Items: []
  - m_Id: 218494916907008
    m_Localized: Conjurador de Tempestades
    m_Metadata:
      m_Items: []
  - m_Id: 218494921101312
    m_Localized: "Desbloqueia Tempestade El\xE9trica: raios numa cruz de casas distantes que atordoam, cancelando os golpes preparados."
    m_Metadata:
      m_Items: []
  - m_Id: 218495558635520
    m_Localized: Arsenal Oculto
    m_Metadata:
      m_Items: []
  - m_Id: 218495558635521
    m_Localized: 'Desbloqueia Adaga de Arremesso: atinge um inimigo distante em linha ou diagonal e o deixa Exposto.'
    m_Metadata:
      m_Items: []
  - m_Id: 218496020008960
    m_Localized: Mestre das Sombras
    m_Metadata:
      m_Items: []
  - m_Id: 218496020008961
    m_Localized: "Desbloqueia Bomba de Fuma\xE7a: cega todos ao seu redor, cancelando os golpes preparados."
    m_Metadata:
      m_Items: []
  - m_Id: 218496955338752
    m_Localized: Mestre do Veneno
    m_Metadata:
      m_Items: []
  - m_Id: 218496955338753
    m_Localized: "Desbloqueia Linha Venenosa: envenena uma linha de 4 casas e a transforma em p\xE2ntano venenoso."
    m_Metadata:
      m_Items: []
