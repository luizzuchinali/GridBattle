  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Content_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 84108cdf327ab9342bf94b3442a30042, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 4496571990016
    m_Localized: Fraquejado
    m_Metadata:
      m_Items: []
  - m_Id: 4496651681792
    m_Localized: Causa 50% menos dano.
    m_Metadata:
      m_Items: []
  - m_Id: 4497024974848
    m_Localized: Armadura de Espinhos
    m_Metadata:
      m_Items: []
  - m_Id: 4497024974849
    m_Localized: Ao ser atacado, devolve dano ao atacante.
    m_Metadata:
      m_Items: []
  - m_Id: 4497381490688
    m_Localized: Roubo de Vida
    m_Metadata:
      m_Items: []
  - m_Id: 4497381490689
    m_Localized: Recupera parte do dano causado como vida.
    m_Metadata:
      m_Items: []
  - m_Id: 4497729617920
    m_Localized: "Regenera\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 4497729617921
    m_Localized: "Recupera vida no in\xEDcio de cada turno."
    m_Metadata:
      m_Items: []
  - m_Id: 4498077745152
    m_Localized: Escudo
    m_Metadata:
      m_Items: []
  - m_Id: 4498077745153
    m_Localized: "Vida tempor\xE1ria que absorve dano antes da vida real."
    m_Metadata:
      m_Items: []
  - m_Id: 4498425872384
    m_Localized: Envenenado
    m_Metadata:
      m_Items: []
  - m_Id: 4498425872385
    m_Localized: "Sofre dano no in\xEDcio de cada turno."
    m_Metadata:
      m_Items: []
  - m_Id: 7824852877312
    m_Localized: Blindado
    m_Metadata:
      m_Items: []
  - m_Id: 7824865460224
    m_Localized: Reduz o dano de cada golpe recebido.
    m_Metadata:
      m_Items: []
  - m_Id: 7825255530496
    m_Localized: Corpo a corpo
    m_Metadata:
      m_Items: []
  - m_Id: 7825255530497
    m_Localized: "Persegue voc\xEA e ataca de perto."
    m_Metadata:
      m_Items: []
  - m_Id: 7825603657728
    m_Localized: Enxame
    m_Metadata:
      m_Items: []
  - m_Id: 7825603657729
    m_Localized: "Fr\xE1gil e r\xE1pido, e aparece em quantidade."
    m_Metadata:
      m_Items: []
  - m_Id: 7825955979264
    m_Localized: Atirador
    m_Metadata:
      m_Items: []
  - m_Id: 7825955979265
    m_Localized: "Ataca de longe e tenta manter a dist\xE2ncia."
    m_Metadata:
      m_Items: []
  - m_Id: 7826312495104
    m_Localized: Suporte
    m_Metadata:
      m_Items: []
  - m_Id: 7826312495105
    m_Localized: "Cura ou fortalece os aliados. Alvo priorit\xE1rio."
    m_Metadata:
      m_Items: []
  - m_Id: 7826656428032
    m_Localized: Invocador
    m_Metadata:
      m_Items: []
  - m_Id: 7826656428033
    m_Localized: Invoca novos inimigos durante a batalha.
    m_Metadata:
      m_Items: []
  - m_Id: 7827000360960
    m_Localized: Controlador
    m_Metadata:
      m_Items: []
  - m_Id: 7827000360961
    m_Localized: "Aplica estados negativos em voc\xEA ou move voc\xEA pelo grid."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462912
    m_Localized: Goblin
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462913
    m_Localized: "Persegue voc\xEA e ataca de perto."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462914
    m_Localized: Slime
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462915
    m_Localized: "Lento e resistente. Avan\xE7a at\xE9 voc\xEA e ataca de perto."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462916
    m_Localized: Rato
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462917
    m_Localized: "R\xE1pido e fr\xE1gil. Se aproxima depressa e morde."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462918
    m_Localized: Morcego-olho
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462919
    m_Localized: "R\xE1pido e fr\xE1gil. Voa at\xE9 voc\xEA e ataca de perto."
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462920
    m_Localized: "Cr\xE2nio de fogo"
    m_Metadata:
      m_Items: []
  - m_Id: 7828103462921
    m_Localized: "Ataca de longe e tenta manter essa dist\xE2ncia."
    m_Metadata:
      m_Items: []
  - m_Id: 7828212514816
    m_Localized: "Xam\xE3 goblin"
    m_Metadata:
      m_Items: []
  - m_Id: 7828212514817
    m_Localized: "Cura e protege os aliados feridos e se mant\xE9m longe de voc\xEA. Elimine-o primeiro."
    m_Metadata:
      m_Items: []
  - m_Id: 7828325761024
    m_Localized: Rainha dos ratos
    m_Metadata:
      m_Items: []
  - m_Id: 7828325761025
    m_Localized: "Invoca ratos para lutar por ela e se mant\xE9m longe de voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 7828430618624
    m_Localized: Olho maldito
    m_Metadata:
      m_Items: []
  - m_Id: 7828430618625
    m_Localized: "Enfraquece voc\xEA de longe e depois se aproxima para atacar."
    m_Metadata:
      m_Items: []
  - m_Id: 7828539670528
    m_Localized: Goblin blindado
    m_Metadata:
      m_Items: []
  - m_Id: 7828539670529
    m_Localized: "A armadura bloqueia parte de cada golpe, ent\xE3o ataques fracos mal o arranham."
    m_Metadata:
      m_Items: []
  - m_Id: 7828652916736
    m_Localized: Slime regenerante
    m_Metadata:
      m_Items: []
  - m_Id: 7828652916737
    m_Localized: "Recupera vida a cada turno. Cause dano r\xE1pido, antes que ele se cure."
    m_Metadata:
      m_Items: []
  - m_Id: 7828757774336
    m_Localized: Rato espinhoso
    m_Metadata:
      m_Items: []
  - m_Id: 7828757774337
    m_Localized: Fere quem o atinge. Ataque de longe ou use dano ao longo do tempo.
    m_Metadata:
      m_Items: []
  - m_Id: 7840745095168
    m_Localized: Golpe
    m_Metadata:
      m_Items: []
  - m_Id: 7840745095169
    m_Localized: "Um golpe r\xE1pido contra um inimigo adjacente."
    m_Metadata:
      m_Items: []
  - m_Id: 7841101611008
    m_Localized: Investida com Escudo
    m_Metadata:
      m_Items: []
  - m_Id: 7841101611009
    m_Localized: "Avan\xE7a com o escudo e atinge uma linha de inimigos."
    m_Metadata:
      m_Items: []
  - m_Id: 7841487486976
    m_Localized: Bola de Fogo
    m_Metadata:
      m_Items: []
  - m_Id: 7841487486977
    m_Localized: "Lan\xE7a uma bola de fogo que queima os inimigos de uma \xE1rea, de qualquer ponto do grid."
    m_Metadata:
      m_Items: []
  - m_Id: 7841844002816
    m_Localized: Nova de Gelo
    m_Metadata:
      m_Items: []
  - m_Id: 7841844002817
    m_Localized: "Uma explos\xE3o de gelo que atinge os inimigos ao redor do alvo."
    m_Metadata:
      m_Items: []
  - m_Id: 7842200518656
    m_Localized: "Tempestade El\xE9trica"
    m_Metadata:
      m_Items: []
  - m_Id: 7842200518657
    m_Localized: Um raio que se abre em cone a partir do alvo.
    m_Metadata:
      m_Items: []
  - m_Id: 7842586394624
    m_Localized: Adaga de Arremesso
    m_Metadata:
      m_Items: []
  - m_Id: 7842586394625
    m_Localized: Arremessa uma adaga em um inimigo distante.
    m_Metadata:
      m_Items: []
  - m_Id: 7842947104768
    m_Localized: "Bomba de Fuma\xE7a"
    m_Metadata:
      m_Items: []
  - m_Id: 7842947104769
    m_Localized: "Lan\xE7a uma bomba de fuma\xE7a em um inimigo ao seu lado."
    m_Metadata:
      m_Items: []
  - m_Id: 7843299426304
    m_Localized: Adaga Envenenada
    m_Metadata:
      m_Items: []
  - m_Id: 7843299426305
    m_Localized: Uma adaga envenenada que atravessa uma linha de inimigos.
    m_Metadata:
      m_Items: []
  - m_Id: 7843660136448
    m_Localized: Linha Venenosa
    m_Metadata:
      m_Items: []
  - m_Id: 7843660136449
    m_Localized: Um longo rastro de veneno que atinge todos os inimigos em linha.
    m_Metadata:
      m_Items: []
  - m_Id: 10290159910912
    m_Localized: Sua primeira batalha
    m_Metadata:
      m_Items: []
  - m_Id: 10290247991296
    m_Localized: "Toque em uma c\xE9lula destacada para andar ou em um inimigo ao alcance para atacar; cada a\xE7\xE3o d\xE1 a vez aos inimigos. Derrot\xE1-los d\xE1 XP: encha a barra para subir de n\xEDvel."
    m_Metadata:
      m_Items: []
  - m_Id: 10290373820416
    m_Localized: Escolha seu caminho
    m_Metadata:
      m_Items: []
  - m_Id: 10290373820417
    m_Localized: "Toque em um n\xF3 para ver a pr\xE9via: o tipo e, nas batalhas, o XP, os pap\xE9is dos inimigos e o terreno. Depois confirme para entrar."
    m_Metadata:
      m_Items: []
  - m_Id: 10290495455232
    m_Localized: "Voc\xEA subiu de n\xEDvel!"
    m_Metadata:
      m_Items: []
  - m_Id: 10290495455233
    m_Localized: "O jogo est\xE1 pausado: escolha 1 de 3 talentos para montar sua build. Voc\xEA tamb\xE9m pode rerrolar a oferta, banir um talento ou pular."
    m_Metadata:
      m_Items: []
  - m_Id: 10290604507136
    m_Localized: "A vida se mant\xE9m"
    m_Metadata:
      m_Items: []
  - m_Id: 10290604507137
    m_Localized: "Sua vida se mant\xE9m na pr\xF3xima batalha. Ela s\xF3 se recupera em n\xF3s de cura ou pela sua build; fique de olho ao planejar sua rota."
    m_Metadata:
      m_Items: []
  - m_Id: 10290717753344
    m_Localized: "N\xF3 de cura"
    m_Metadata:
      m_Items: []
  - m_Id: 10290717753345
    m_Localized: "Aqui voc\xEA recupera vida. Planeje sua rota para chegar a um antes que sua vida acabe."
    m_Metadata:
      m_Items: []
  - m_Id: 10290826805248
    m_Localized: "N\xF3 de talento"
    m_Metadata:
      m_Items: []
  - m_Id: 10290826805249
    m_Localized: "Aqui voc\xEA pode obter um talento fora das subidas de n\xEDvel, pagando um custo. Veja se vale a pena."
    m_Metadata:
      m_Items: []
  - m_Id: 10290944245760
    m_Localized: "Consum\xEDveis"
    m_Metadata:
      m_Items: []
  - m_Id: 10290944245761
    m_Localized: "Consum\xEDveis s\xE3o de uso \xFAnico e s\xF3 funcionam em batalha. Usar um n\xE3o gasta sua a\xE7\xE3o, mas s\xF3 \xE9 poss\xEDvel usar um por turno."
    m_Metadata:
      m_Items: []
  - m_Id: 10291057491968
    m_Localized: Detalhes
    m_Metadata:
      m_Items: []
  - m_Id: 10291057491969
    m_Localized: 'Segure (clique direito no PC) em um personagem para ver atributos, skills e estados ativos. Isso nunca gasta seu turno: feche a janela no X.'
    m_Metadata:
      m_Items: []
  - m_Id: 10291187515392
    m_Localized: Skills
    m_Metadata:
      m_Items: []
  - m_Id: 10291187515393
    m_Localized: "Toque no bot\xE3o de uma skill e depois em uma c\xE9lula destacada para us\xE1-la; toque de novo para cancelar. As skills t\xEAm um tempo de recarga, contado em a\xE7\xF5es."
    m_Metadata:
      m_Items: []
  - m_Id: 141742633615360
    m_Localized: "Po\xE7\xE3o de Cura"
    m_Metadata:
      m_Items: []
  - m_Id: 141742713307136
    m_Localized: "Restaura 30 de vida. Us\xE1-la n\xE3o gasta a sua a\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 141743153709056
    m_Localized: Bomba
    m_Metadata:
      m_Items: []
  - m_Id: 141743153709057
    m_Localized: "Arremesse a at\xE9 3 c\xE9lulas: causa 15 de dano a cada inimigo em uma \xE1rea 3x3. N\xE3o gasta a sua a\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 141743547973632
    m_Localized: "T\xF4nico de Regenera\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 141743547973633
    m_Localized: "Recupera vida ao longo de 3 turnos. N\xE3o gasta a sua a\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 142151209156608
    m_Localized: Rocha
    m_Metadata:
      m_Items: []
  - m_Id: 142151209156609
    m_Localized: "Entulho bloqueia o caminho: ningu\xE9m pode ocupar nem atravessar esta c\xE9lula."
    m_Metadata:
      m_Items: []
  - m_Id: 142151704084480
    m_Localized: Fogo
    m_Metadata:
      m_Items: []
  - m_Id: 142151704084481
    m_Localized: Queima quem terminar o turno sobre ela.
    m_Metadata:
      m_Items: []
  - m_Id: 142152127709184
    m_Localized: "P\xE2ntano Venenoso"
    m_Metadata:
      m_Items: []
  - m_Id: 142152127709185
    m_Localized: Envenena quem terminar o turno sobre ela.
    m_Metadata:
      m_Items: []
  - m_Id: 142152563916800
    m_Localized: "Santu\xE1rio de Cura"
    m_Metadata:
      m_Items: []
  - m_Id: 142152563916801
    m_Localized: "Concede Regenera\xE7\xE3o a quem terminar o turno sobre ela."
    m_Metadata:
      m_Items: []
  - m_Id: 142153050456064
    m_Localized: Pedra Protetora
    m_Metadata:
      m_Items: []
  - m_Id: 142153050456065
    m_Localized: Concede um Escudo a quem terminar o turno sobre ela.
    m_Metadata:
      m_Items: []
  - m_Id: 151679795429376
    m_Localized: Rei Goblin
    m_Metadata:
      m_Items: []
  - m_Id: 151679891898368
    m_Localized: "Chefe final provis\xF3rio: um rei goblin mais forte que qualquer goblin."
    m_Metadata:
      m_Items: []
  - m_Id: 151679891898369
    m_Localized: "Avan\xE7a em voc\xEA e bate forte. Vem com dois guardas blindados."
    m_Metadata:
      m_Items: []
  - m_Id: 151680038699008
    m_Localized: Guarda Goblin
    m_Metadata:
      m_Items: []
  - m_Id: 151680038699009
    m_Localized: "Escolta provis\xF3ria do chefe final. Blindado."
    m_Metadata:
      m_Items: []
  - m_Id: 151680038699010
    m_Localized: "Persegue voc\xEA e ataca de perto. Recebe menos dano de cada golpe."
    m_Metadata:
      m_Items: []
  - m_Id: 218482187194368
    m_Localized: Ataque
    m_Metadata:
      m_Items: []
  - m_Id: 218482434658304
    m_Localized: Defesa
    m_Metadata:
      m_Items: []
  - m_Id: 218482585653248
    m_Localized: "Cr\xEDtico"
    m_Metadata:
      m_Items: []
  - m_Id: 218482719870976
    m_Localized: Habilidades
    m_Metadata:
      m_Items: []
  - m_Id: 218482841505792
    m_Localized: "Recupera\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 218482958946304
    m_Localized: Utilidade
    m_Metadata:
      m_Items: []
  - m_Id: 218483076386816
    m_Localized: "Guardi\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 218483202215936
    m_Localized: Arcano
    m_Metadata:
      m_Items: []
  - m_Id: 218483328045056
    m_Localized: Sombra
    m_Metadata:
      m_Items: []
  - m_Id: 218483445485568
    m_Localized: Veneno
    m_Metadata:
      m_Items: []
  - m_Id: 218484057853952
    m_Localized: Vitalidade
    m_Metadata:
      m_Items: []
  - m_Id: 218484057853953
    m_Localized: "+10 de vida m\xE1xima por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218484464701440
    m_Localized: "L\xE2mina Afiada"
    m_Metadata:
      m_Items: []
  - m_Id: 218484464701441
    m_Localized: "+2 de dano do ataque b\xE1sico por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218484909297664
    m_Localized: "Olho Agu\xE7ado"
    m_Metadata:
      m_Items: []
  - m_Id: 218484909297665
    m_Localized: "+5% de chance de cr\xEDtico por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218485311950848
    m_Localized: "Precis\xE3o Letal"
    m_Metadata:
      m_Items: []
  - m_Id: 218485311950849
    m_Localized: "+0,25x no multiplicador de dano cr\xEDtico por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218485693632512
    m_Localized: "Perfura\xE7\xE3o de Armadura"
    m_Metadata:
      m_Items: []
  - m_Id: 218485693632513
    m_Localized: "Ignora 10% da defesa do alvo por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218486079508480
    m_Localized: Robustez
    m_Metadata:
      m_Items: []
  - m_Id: 218486079508481
    m_Localized: "+1 de defesa por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218486490550272
    m_Localized: Maestria em Habilidades
    m_Metadata:
      m_Items: []
  - m_Id: 218486490550273
    m_Localized: "+10% de dano nas habilidades ofensivas por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218486876426240
    m_Localized: Longo Alcance
    m_Metadata:
      m_Items: []
  - m_Id: 218486876426241
    m_Localized: "+1 de alcance das habilidades por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218487270690816
    m_Localized: "Recupera\xE7\xE3o R\xE1pida"
    m_Metadata:
      m_Items: []
  - m_Id: 218487270690817
    m_Localized: "As habilidades recuperam 1 a\xE7\xE3o mais cedo por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218487669149696
    m_Localized: Armadura de Espinhos
    m_Metadata:
      m_Items: []
  - m_Id: 218487669149697
    m_Localized: "Ao ser atacado, devolve 2 de dano ao atacante por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218488046637056
    m_Localized: Roubo de Vida
    m_Metadata:
      m_Items: []
  - m_Id: 218488046637057
    m_Localized: "Recupera 5% do dano causado como vida por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218488432513024
    m_Localized: "Regenera\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 218488432513025
    m_Localized: "Recupera 2 de vida no in\xEDcio de cada um dos seus turnos por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218488814194688
    m_Localized: "Mais Op\xE7\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 218488814194689
    m_Localized: "+1 op\xE7\xE3o de talento em cada oferta por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218489191682048
    m_Localized: Favor da Sorte
    m_Metadata:
      m_Items: []
  - m_Id: 218489191682049
    m_Localized: "+1 reroll das ofertas de talento por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218489581752320
    m_Localized: Banidor
    m_Metadata:
      m_Items: []
  - m_Id: 218489581752321
    m_Localized: "+1 banimento das ofertas de talento por ac\xFAmulo."
    m_Metadata:
      m_Items: []
  - m_Id: 218489829216256
    m_Localized: Vitalidade
    m_Metadata:
      m_Items: []
  - m_Id: 218489829216257
    m_Localized: "+10 de vida m\xE1xima por n\xEDvel do talento."
    m_Metadata:
      m_Items: []
  - m_Id: 218490064097280
    m_Localized: "L\xE2mina Afiada"
    m_Metadata:
      m_Items: []
  - m_Id: 218490064097281
    m_Localized: "+2 de dano do ataque b\xE1sico por n\xEDvel do talento."
