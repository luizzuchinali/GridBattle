    m_Localized: Gelo Escorregadio
    m_Metadata:
      m_Items: []
  - m_Id: 5123291685134337
    m_Localized: "Quando um inimigo que voc\xEA empurra ou puxa bate em outro personagem, esse tamb\xE9m \xE9 empurrado 1 casa na mesma dire\xE7\xE3o."
