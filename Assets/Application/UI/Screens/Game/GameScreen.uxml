                </ui:Image>
                <ui:Label text="XP" name="current-level"/>
            </ui:VisualElement>
            <ui:Button name="trait-button" class="slot-button" icon-image="project://database/Assets/Application/Art/Sprites/UI.png?fileID=-178838057&amp;guid=62a3f1345f5495642b6ab1f188fd400c&amp;type=3#TreeIcon"/>
        </ui:VisualElement>
        <ui:VisualElement name="game-content" picking-mode="Ignore"/>
        <ui:VisualElement name="spell-area" picking-mode="Ignore">
            <ui:Button class="slot-button" text="" enable-rich-text="false" emoji-fallback-support="false"/>
            <ui:VisualElement class="spacing-sm"/>
            <ui:Button class="slot-button" text="" enable-rich-text="false" emoji-fallback-support="false"/>
            <ui:VisualElement class="spacing-sm"/>
            <ui:Button class="slot-button" text="" enable-rich-text="false" emoji-fallback-support="false"/>
            <ui:VisualElement class="spacing-sm"/>
            <ui:Button class="slot-button" text="" enable-rich-text="false" emoji-fallback-support="false"/>
            <ui:VisualElement class="spacing-sm"/>
            <ui:Button class="slot-button" text="" enable-rich-text="false" emoji-fallback-support="false"/>
            <ui:VisualElement class="spacing-sm"/>
            <ui:Button class="slot-button" text="" enable-rich-text="false" emoji-fallback-support="false"/>
        </ui:VisualElement>
    </zs:SafeArea>
</ui:UXML>
