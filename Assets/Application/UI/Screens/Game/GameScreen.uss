/* Vertical budget at the 216x384 reference: XP bar 32 + grid 286 + item bar 32 + skill bar 32 = 382,
   so no padding: the bars hug the screen edges (the safe area still insets them on devices). */
#container {
    background-color: rgba(0, 0, 0, 0);
    align-self: center;
    width: 202px;
    padding-top: 0;
    padding-bottom: 0;
}

/* XP area (top bar) */
#xp-area {
    flex-direction: row;
    justify-content: center;
    width: 100%;
    min-height: 32px;
    max-height: 32px;
}

/* Run depth tile, left of the XP bar. Keeps its place (invisible) while there is no depth. */
#hud-depth {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-image: var(--skin-slot);
}

#hud-depth.hud-depth--hidden {
    visibility: hidden;
}

#hud-depth-caption {
    margin: 0;
    padding: 0;
    font-size: var(--font-size-hud);
    color: var(--color-xp-level);
    -unity-text-align: middle-center;
}

#hud-depth-value {
    margin: 0;
    padding: 0;
    font-size: var(--font-size-body);
    color: var(--color-primary);
    -unity-text-align: middle-center;
}

#xp-bar {
    font-size: var(--font-size-hud);
    margin: 0;
    flex-grow: 1;
    margin-right: var(--spacing-sm);
    margin-left: var(--spacing-sm);
    width: 134px;
    height: 32px;
}

#xp-bar-detail-1 {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* Width is driven at runtime by XpBarView (0..110px). XpBarView relies on
   these measurements: frame 112px, progress up to 110px, 1px border. */
#xp-bar-progress {
    background-image: var(--skin-xp-bar-progress);
    width: 110px;
    height: 10px;
    align-self: center;
    justify-content: flex-end;
    position: absolute;
    left: 12px;
    top: 11px;
    -unity-slice-type: sliced;
    background-position-x: left 0;
    background-position-y: top 0;
    -unity-background-scale-mode: stretch-to-fill;
    background-repeat: no-repeat no-repeat;
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
}

#xp-bar-detail-2 {
    width: 112px;
    height: 12px;
}

#current-level {
    position: absolute;
    top: 8px;
    left: 106px;
    height: 8px;
    width: 15px;
    color: var(--color-xp-level);
    font-size: 12px;
    -unity-text-outline-width: 0;
    -unity-text-align: middle-center;
    align-items: center;
    white-space: normal;
    align-content: center;
    justify-content: center;
    align-self: center;
}

/* Game content (transparent area over the grid) */
#game-content {
    flex-grow: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
}
