#container {
    background-color: rgba(0, 0, 0, 0);
    align-self: center;
    width: 202px;
    padding-top: 8px;
    padding-bottom: 8px;
}

/* XP area (top bar) */
#xp-area {
    flex-direction: row;
    justify-content: center;
    width: 100%;
    min-height: 32px;
    max-height: 32px;
}

#xp-bar {
    font-size: var(--font-size-hud);
    margin: 0;
    flex-grow: 1;
    margin-right: var(--spacing-sm);
    margin-left: var(--spacing-sm);
    width: 134px;
    height: 32px;
}

#xp-bar-detail-1 {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* Width is driven at runtime by XpBarView (0..110px). XpBarView relies on
   these measurements: frame 112px, progress up to 110px, 1px border. */
#xp-bar-progress {
    background-image: var(--skin-xp-bar-progress);
    width: 110px;
    height: 10px;
    align-self: center;
    justify-content: flex-end;
    position: absolute;
    left: 12px;
    top: 11px;
    -unity-slice-type: sliced;
    background-position-x: left 0;
    background-position-y: top 0;
    -unity-background-scale-mode: stretch-to-fill;
    background-repeat: no-repeat no-repeat;
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
}

#xp-bar-detail-2 {
    width: 112px;
    height: 12px;
}

#current-level {
    position: absolute;
    top: 8px;
    left: 106px;
    height: 8px;
    width: 15px;
    color: var(--color-xp-level);
    font-size: 12px;
    -unity-text-outline-width: 0;
    -unity-text-align: middle-center;
    align-items: center;
    white-space: normal;
    align-content: center;
    justify-content: center;
    align-self: center;
}

/* Game content (transparent area over the grid) */
#game-content {
    flex-grow: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
}

/* Skill slots (bottom bar) */
#spell-area {
    flex-grow: 1;
    justify-content: center;
    flex-direction: row;
    width: 100%;
    min-height: 32px;
}
