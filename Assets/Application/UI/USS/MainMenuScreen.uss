#container {
    flex-grow: 1;
    background-color: var(--color-bg);
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

ScrollView > Button {
    height: 48px;
    width: 32px;
    margin-right: var(--spacing-sm);
    font-size: 10px;
    -unity-text-align: middle-center;
}

ScrollView > Button .last { margin-right: 0; }