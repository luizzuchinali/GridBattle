#container {
    flex-grow: 1;
    background-color: var(--color-bg);
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

#container > Label {
    font-size: 12px;
    color: var(--color-primary);
    -unity-text-align: middle-center;
    margin: var(--spacing-sm);
    padding: 0;
}

ScrollView {
    width: 100%;
    flex-direction: row;
    align-self: flex-start;
}

ScrollView > Button {
    height: 48px;
    width: 32px;
    margin-right: var(--spacing-sm);
    font-size: 10px;
    -unity-text-align: middle-center;
}