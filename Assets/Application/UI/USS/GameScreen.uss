#container {
    --font-size: 10px;
    background-color: rgba(0, 0, 0, 0);
    align-self: center;
    width: 202px;
    padding-top: 8px;
    padding-bottom: 8px;
}

#xp-area {
    flex-direction: row;
    justify-content: center;
    width: 100%;
    min-height: 22px;
    max-height: 22px;
}

#xp-bar {
    font-size: var(--font-size);
    margin: 0;
    flex-grow: 1;
    margin-right: var(--spacing-sm);
}

#xp-area #unity-progress-bar {
    min-height: 100%;
}

#xp-area #unity-progress-bar > VisualElement {

}

#xp-area > Button {
    font-size: var(--font-size);
    width: 32px;
    margin: 0;
}

#game-content {
    flex-direction: column;
    width: 100%;
    height: 100%;
}

#spell-area {
    justify-content: center;
    flex-direction: row;
    width: 100%;
    min-height: 32px;
}

#spell-area > Button {
    font-size: var(--font-size);
    width: 32px;
    margin: 0;
    padding: 0;
}