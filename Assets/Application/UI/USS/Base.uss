:root {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts & Materials/ThaleahFat_TTF.ttf");

    /* Color Tokens */
    --color-bg: rgb(27, 27, 27);
    --color-primary: #ffcc00;

    /* Spacing Tokens */
    --spacing-sm: 2px;
    --spacing-md: 4px;
}

.spacing-sm {
    min-width: var(--spacing-sm);
}

.container {
    flex-grow: 1;
    background-color: var(--color-bg);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition-duration: 0.25s;
    width: 100%;
}

.container > Label {
    font-size: 12px;
    color: var(--color-primary);
    -unity-text-align: middle-center;
    margin: var(--spacing-sm);
    padding: 0;
}

.opacity-0 {
    opacity: 0;
}

.opacity-1 {
    opacity: 1;
}

.display-none {
    display: none;
}

.translate-right {
    translate: 216px 0;
}

.translate-left {
    translate: -216px 0;
}