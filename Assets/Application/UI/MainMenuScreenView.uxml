<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:gb="GridBattle.UI" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
