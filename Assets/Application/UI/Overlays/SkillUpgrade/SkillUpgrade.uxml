<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zs="ZS.UI" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Application/UI/Overlays/SkillUpgrade/SkillUpgrade.uss?fileID=7433441132597879392&amp;guid=7d4cce37a7634e9eafd27c63a73477ba&amp;type=3#SkillUpgrade"/>
    <zs:SafeArea name="container" picking-mode="Ignore" class="container overlay-screen">
        <ui:VisualElement name="overlay-background">
            <ui:VisualElement name="upgrade-window" class="window-frame">
                <ui:Label name="upgrade-title" text="Camp" picking-mode="Ignore"/>
                <ui:Label name="upgrade-subtitle" picking-mode="Ignore"/>
                <ui:ScrollView name="upgrade-scroll" class="slim-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" touch-scroll-type="Clamped"/>
                <ui:VisualElement name="upgrade-buttons">
                    <ui:Button name="upgrade-back-button" text="Back" class="text-button"/>
                    <ui:Button name="upgrade-decline-button" text="Not now" class="text-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </zs:SafeArea>
</ui:UXML>
