#container {
    background-color: var(--color-overlay-dim);
    padding-top: 0;
    padding-bottom: 0;
}

/* Swallows every touch: nothing behind the window reacts, and tapping here never closes it. */
#overlay-background {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: center;
}

#details-window {
    width: 200px;
    max-height: 340px;
    flex-shrink: 1;
}

/* Title row: portrait (when the character has one) and name. Leaves room for the X button. */
#details-header {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    margin-bottom: 4px;
    padding-right: 20px;
}

#details-portrait {
    width: 36px;
    height: 30px;
    margin-right: var(--spacing-md);
    flex-shrink: 0;
}

.details-portrait--hidden {
    display: none;
}

#details-title {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    font-size: var(--font-size-title);
    color: var(--color-primary);
    white-space: normal;
    -unity-text-align: middle-left;
}

/* The only way to close the window. Sits on the frame corner. */
#container #close-button {
    position: absolute;
    top: -6px;
    right: -6px;
    height: 32px;
    font-size: var(--font-size-title);
    color: var(--color-primary);
    -unity-text-align: middle-center;
}

#details-scroll {
    flex-grow: 0;
    flex-shrink: 1;
    width: 100%;
}

/* Slim scrollbar: no arrows, a thin track and a gold handle. */
#details-scroll .unity-scroller__low-button,
#details-scroll .unity-scroller__high-button {
    display: none;
}

#details-scroll .unity-scroller--vertical {
    width: 4px;
    margin-left: var(--spacing-md);
    border-width: 0;
    background-color: transparent;
}

#details-scroll .unity-scroller--vertical .unity-base-slider__drag-container {
    width: 4px;
    margin: 0;
    padding: 0;
}

#details-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    width: 4px;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0.35);
}

#details-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    width: 4px;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--color-primary);
}

.details-section-title {
    margin: var(--spacing-md) 0 var(--spacing-sm) 0;
    padding: 0;
    font-size: var(--font-size-body);
    color: var(--color-primary);
    -unity-text-align: middle-left;
}

.details-row {
    flex-direction: row;
    align-items: center;
    min-height: 12px;
}

.details-row__label {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    font-size: var(--font-size-body);
    color: var(--color-text);
    white-space: normal;
    -unity-text-align: middle-left;
}

.details-row__value {
    flex-shrink: 0;
    margin: 0 0 0 var(--spacing-md);
    padding: 0;
    font-size: var(--font-size-body);
    color: var(--color-text);
    -unity-text-align: middle-right;
}

.details-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: var(--spacing-md);
}

.details-text {
    margin: 0;
    padding: 0;
    font-size: var(--font-size-body);
    color: var(--color-text-dim);
    white-space: normal;
    -unity-text-align: upper-left;
}

.details-row--hp .details-row__value,
.details-row--ready .details-row__value,
.details-row--buff .details-row__value {
    color: var(--color-good);
}

.details-row--waiting .details-row__value {
    color: var(--color-text-dim);
}

.details-row--debuff .details-row__value {
    color: var(--color-bad);
}
