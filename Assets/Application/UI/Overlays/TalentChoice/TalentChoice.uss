/*
 * Talent choice (interface 4.1): the offered talents as tappable cards, the tools (reroll, ban, skip) at the
 * bottom. The window is a modal over the battle or the map; the dim background swallows every touch.
 */
#overlay-background {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: center;
}

#talent-window {
    width: 200px;
    max-height: 350px;
    flex-shrink: 1;
    padding-top: 12px;
    padding-bottom: 12px;
    transition-property: opacity;
    transition-duration: var(--transition-fade);
}

.talent-window--closing {
    opacity: 0;
}

#talent-title {
    margin: 0;
    padding: 0;
    font-size: var(--font-size-title);
    color: var(--color-primary);
    white-space: normal;
    -unity-text-align: middle-center;
}

#talent-subtitle {
    margin: 0 0 var(--spacing-md) 0;
    padding: 0;
    font-size: var(--font-size-body);
    color: var(--color-text-dim);
    white-space: normal;
    -unity-text-align: middle-center;
}

#talent-queued {
    margin: 0 0 var(--spacing-sm) 0;
    padding: 0;
    font-size: var(--font-size-hud);
    color: var(--color-xp-level);
    -unity-text-align: middle-center;
}

#talent-scroll {
    flex-grow: 0;
    flex-shrink: 1;
    width: 100%;
}

/* A talent card: the slot skin with an icon, name, rank, description and badges. */
#container .talent-card {
    flex-direction: column;
    align-items: stretch;
    margin: var(--spacing-sm) 0;
    padding: 5px 6px;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    background-image: var(--skin-slot);
    -unity-slice-left: 8;
    -unity-slice-top: 8;
    -unity-slice-right: 8;
    -unity-slice-bottom: 8;
    -unity-text-align: middle-left;
    transition-property: opacity, translate;
    transition-duration: var(--transition-fade);
}

#container .talent-card:active {
    background-image: var(--skin-slot-pressed);
}

/* The option combines with the build: highlighted frame. */
#container .talent-card--match {
    background-image: var(--skin-slot-selected);
}

/* Ban mode: every card is tinted red and says "tap to ban". */
#container .talent-card--ban {
    -unity-background-image-tint-color: var(--color-ban-tint);
}

/* Enter animation: cards fade in one after the other. */
#container .talent-card--hidden {
    opacity: 0;
    translate: 0 4px;
}

/* Acquisition effect: the chosen card shines, the others fade away. */
#container .talent-card--chosen {
    -unity-background-image-tint-color: var(--color-card-chosen);
}

#container .talent-card--dim {
    opacity: 0.25;
}

.talent-card__top {
    flex-direction: row;
    align-items: flex-start;
}

.talent-card__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin: 1px 6px 0 0;
}

.talent-card__texts {
    flex-grow: 1;
    flex-shrink: 1;
}

.talent-card__title-row {
    flex-direction: row;
    align-items: flex-start;
}

.talent-card__name {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    font-size: var(--font-size-body);
    color: var(--color-primary);
    white-space: normal;
    -unity-text-align: upper-left;
}

.talent-card__rank {
    flex-shrink: 0;
    margin: 0 0 0 var(--spacing-md);
    padding: 0;
    font-size: var(--font-size-body);
    color: var(--color-xp-level);
    -unity-text-align: upper-right;
}

.talent-card__desc {
    margin: 0;
    padding: 0;
    font-size: var(--font-size-hud);
    color: var(--color-text);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* The highlighted frame is bright: keep the build badge readable on it. */
#container .talent-card--match .badge--match .badge__label {
    color: var(--color-text);
}

.talent-card__badges {
    margin-top: var(--spacing-sm);
}

/* Tools row: reroll, ban, skip with the uses left. */
#talent-tools {
    flex-direction: row;
    justify-content: space-between;
    flex-shrink: 0;
    margin-top: var(--spacing-md);
}

#container #talent-tools .talent-tool {
    min-width: 0;
    flex-grow: 1;
    flex-basis: 0;
    height: 22px;
    margin: 0 1px;
    padding: 0 2px;
    font-size: var(--font-size-hud);
}
